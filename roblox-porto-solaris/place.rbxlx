]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">Super</string><ProtectedString name="Source"><![CDATA[local Category = {}
Category.NAME = "Super (800 créditos)"
Category.ATTRIBUTE = "Super"
Category.ACCESS = "CUSTOM"
Category.HIDDEN = false
Category.PRIORITY = 2
Category.GAMEPASS_ID = 0
Category.PROMPT_GAMEPASS = false
Category.CanPlayerSpawn = function(plr)
	if Category.ACCESS == "CUSTOM" then
		local ls = plr:FindFirstChild("leaderstats")
		return ls ~= nil and ls:FindFirstChild("Creditos") ~= nil and ls.Creditos.Value >= 800
	end
	return true
end
return Category
