	part({ Shape = Enum.PartType.Cylinder, Size = V(0.12, 26.6, 26.6), CFrame = CFrame.new(X0, 0.48, -50) * CFrame.Angles(0, 0, math.rad(90)), Color = rgb(120, 200, 255), Material = Enum.Material.Neon, CastShadow = false })
