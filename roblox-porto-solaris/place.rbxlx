sound.Parent = car.DriveSeat

RemoteEvent.OnServerEvent:Connect(function()
	sound:Play()
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item></Item><Item class="ScreenGui" referent="RBXV070000000000000000000000000314"><Properties><bool name="AutoLocalize">true</bool><bool name="ClipToDeviceSafeArea">true</bool><bool name="DefinesCapabilities">false</bool><int name="DisplayOrder">0</int><bool name="Enabled">true</bool><string name="Name">Icon</string><bool name="ResetOnSpawn">true</bool><Ref name="RootLocalizationTable">null</Ref><token name="SafeAreaCompatibility">1</token><token name="ScreenInsets">2</token><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><int64 name="SourceAssetId">-1</int64><token name="ZIndexBehavior">1</token></Properties><Item class="Frame" referent="RBXV070000000000000000000000000315"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0.0</X><Y>0.0</Y></Vector2><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><float name="BackgroundTransparency">1.0</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">1</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><string name="Name">Icon</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><UDim2 name="Position"><XS>0.6472843885421753</XS><XO>0</XO><YS>0.8826252222061157</YS><YO>0</YO></UDim2><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0.0</float><bool name="Selec