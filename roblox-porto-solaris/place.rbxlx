x><X>0.0</X><Y>0.0</Y></max></Rect2D><float name="SliceScale">1.0</float><int64 name="SourceAssetId">-1</int64><UDim2 name="TileSize"><XS>1.0</XS><XO>0</XO><YS>1.0</YS><YO>0</YO></UDim2><bool name="Visible">true</bool><int name="ZIndex">2</int></Properties></Item></Item></Item></Item></Item></Item><Item class="LocalScript" referent="RBXV0300000000000000000000000003F2"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">AC6_First_Person_Gauges</string><token name="RunContext">0</token><string name="ScriptGuid">{4279602F-EA25-4783-B778-0F5F68DA7CA7}</string><ProtectedString name="Source"><![CDATA[--[[
