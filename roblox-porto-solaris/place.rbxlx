e="PivotOffset"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><float name="Reflectance">0.0</float><token name="RenderFidelity">1</token><float name="RightParamA">-0.5</float><float name="RightParamB">0.5</float><token name="RightSurface">10</token><token name="RightSurfaceInput">0</token><int name="RootPriority">0</int><Vector3 name="RotVelocity"><X>0.0</X><Y>0.0</Y><Z>0.0</Z></Vector3><int64 name="SourceAssetId">-1</int64><string name="TextureID">rbxassetid://701552639</string><float name="TopParamA">-0.5</float><float name="TopParamB">0.5</float><token name="TopSurface">10</token><token name="TopSurfaceInput">0</token><float name="Transparency">0.0</float><Vector3 name="UnscaledCofm"><X>nan</X><Y>nan</Y><Z>nan</Z></Vector3><Vector3 name="UnscaledVolInertiaDiags"><X>nan</X><Y>nan</Y><Z>nan</Z></Vector3><Vector3 name="UnscaledVolInertiaOffDiags"><X>nan</X><Y>nan</Y><Z>nan</Z></Vector3><float name="UnscaledVolume">nan</float><Vector3 name="Velocity"><X>0.0</X><Y>0.0</Y><Z>0.0</Z></Vector3><int name="VertexCount">0</int><Vector3 name="size"><X>0.6217736601829529</X><Y>0.24027001857757568</Y><Z>0.24027001857757568</Z></Vector3></Properties></Item><Item class="MeshPart" referent="RBXV05000000000000000000000000009F"><Properties><bool name="Anchored">true</bool><float name="BackParamA">-0.5</float><float name="BackParamB">0.5</float><token name="BackSurface">10</token><token name="BackSurfaceInput">0</token><float name="BottomParamA">-0.5</float><float name="BottomParamB">0.5</float><token name="BottomSurface">10</token><token name="BottomSurfaceInput">0</token><CoordinateFrame name="CFrame"><X>-50.265037536621094</X><Y>1.5547995567321777</Y><Z>7.117720127105713</Z><R00>1.000000238418579</R00><R01>1.799066694729845e-06</R01><R02>0.00014886687858961523</R02><R10>-1.8648598825166118e-06</R10><R11>1.0000001192092896</R11><R12>0.0004419478354975581</R12><R20>-0.00014