58"><Properties><token name="AlphaMode">0</token><Color3 name="Color"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><Content name="ColorMap"><null></null></Content><bool name="DefinesCapabilities">false</bool><Content name="MetalnessMap"><url>rbxassetid://26884682</url></Content><string name="Name">Glass 2</string><Content name="NormalMap"><null></null></Content><Content name="RoughnessMap"><url>rbxassetid://3373953827</url></Content><int64 name="SourceAssetId">-1</int64><string name="TexturePack">rbxassetid://11867363494</string></Properties></Item></Item><Item class="Script" referent="RBXV040000000000000000000000000259"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Interior Textures</string><token name="RunContext">0</token><string name="ScriptGuid">{dfb4c9fc-c627-49cc-90c7-9ff7a1b9c1ba}</string><ProtectedString name="Source"><![CDATA[Green - 13036748657
