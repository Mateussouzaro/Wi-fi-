backfire = false
horn = false
brakewhistle = false
ignition = false
audioname = "Start" -- the name of your startup audio (defaults as "Start") (only works with ignition on)

-- the script ----------------------

local effect = script.soundeffect

if level >= 0 and level <= 100 then
	effect.HighGain = (level*-1)/2
	effect.MidGain = (level*-1)/2
elseif level < 0 then
	effect.HighGain = -0
	effect.MidGain = -0
elseif level > 100 then
	effect.HighGain = -50
	effect.MidGain = -50
end

