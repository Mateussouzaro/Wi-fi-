000000000031A"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Handler</string><token name="RunContext">0</token><string name="ScriptGuid">{301C3FF6-DCB8-4DE1-80D4-76EDE7894B6D}</string><ProtectedString name="Source"><![CDATA[--[[

   ____ ___   ____ _____ __    ____ _____ __ __ ______ ____  _   __ ____
  / __// _ \ /  _// ___// /   /  _// ___// // //_  __// __/ | | / // / /
