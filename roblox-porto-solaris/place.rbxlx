local car = script.Parent.Parent
local Misc = car.Misc
--

--Script
script.Parent.ChildAdded:connect(function(child)
	wait()
	
	if child.Name == "SeatWeld" then
	local heman = child.Part1.Parent
	Misc.FakeLimbs["Left Leg"].Transparency = 0
		if heman:FindFirstChild("Left Leg") then
			Misc.FakeLimbs["Right Leg"].Transparency = 0
			Misc.FakeLimbs["Left Leg"].Color = heman["Left Leg"].Color
			Misc.FakeLimbs["Right Leg"].Color = heman["Right Leg"].Color
			heman["Left Leg"].Transparency = 1
			heman["Right Leg"].Transparency = 1
		else
			Misc.FakeLimbs["Right Leg"].Transparency = 0
			Misc.FakeLimbs["Left Leg"].Color = heman["LeftUpperLeg"].Color
			Misc.FakeLimbs["Right Leg"].Color = heman["RightUpperLeg"].Color
			Misc.FakeLimbs["Left Leg"].Color = heman["LeftLowerLeg"].Color
			Misc.FakeLimbs["Right Leg"].Color = heman["RightLowerLeg"].Color
			
			heman["LeftUpperLeg"].Transparency = 1
			heman["RightUpperLeg"].Transparency = 1
			heman["LeftLowerLeg"].Transparency = 1
			heman["RightLowerLeg"].Transparency = 1
		end
		
		Misc.FakeLimbs.Pants.PantsTemplate = heman.Pants.PantsTemplate
	end
end)

script.Parent.ChildRemoved:connect(function(child)
	wait()
	
	if child.Name == "SeatWeld" then
		local heman = child.Part1.Parent
	Misc.FakeLimbs["Left Leg"].Transparency = 1
	Misc.FakeLimbs["Right Leg"].Transparency = 1
		if heman:FindFirstChild("Left Leg") then
			heman["Left Leg"].Transparency = 0
			heman["Right Leg"].Transparency = 0
		else
			heman["LeftUpperLeg"].Transparency = 0
			heman["RightUpperLeg"].Transparency = 0
			heman["LeftLowerLeg"].Transparency = 0
			heman["RightLowerLeg"].Transparency = 0
		end
	end
end)
--]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="Script" referent="RBXV07000000000000000000000000035B"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">ArmScript (Driveseat)</string><token name="RunContext">0</token><string name="ScriptGuid">{007DCE8F-E008-4643-9F7B-20B21776CCEC}</string><ProtectedString name="Source"><![CDATA[--Variables
local car = script.Parent.Parent
local Misc = car.Misc

--Script
script.Parent.ChildAdded:connect(function(child)
	wait()
	
	if child.Name == "SeatWeld" then
	local heman = child.Part1.Parent
	Misc.FakeLimbs["Left Arm"].Transparency = 0
		Misc.FakeLimbs["Right Arm"].Transparency = 0
		if heman:FindFirstChild("Left Arm") then
			Misc.FakeLimbs["Left Arm"].Color = heman["Left Arm"].Color
		else
			Misc.FakeLimbs["Left Arm"].Color = heman["LeftUpperArm"].Color
		end
		if heman:FindFirstChild("Right Arm") then
			Misc.FakeLimbs["Right Arm"].Color = heman["Right Arm"].Color
		else
			Misc.FakeLimbs["Right Arm"].Color = heman["RightUpperArm"].Color
		end
		if heman:FindFirstChild("Left Arm") then
			heman["Left Arm"].Transparency = 1
			heman["Right Arm"].Transparency = 1
		else
			heman["LeftUpperArm"].Transparency = 1
			heman["LeftLowerArm"].Transparency = 1
			heman["RightUpperArm"].Transparency = 1
			heman["RightLowerArm"].Transparency = 1
		end
		Misc.FakeLimbs.Shirt.ShirtTemplate = heman.Shirt.ShirtTemplate
	end
end)

script.Parent.ChildRemoved:connect(function(child)
	wait()
	
	if child.Name == "SeatWeld" then
		local heman = child.Part1.Parent
	Misc.FakeLimbs["Left Arm"].Transparency = 1
	Misc.FakeLimbs["Right Arm"].Transparency = 1
		if heman:FindFirstChild("Left Arm") then
			heman["Left Arm"].Transparency = 0
			heman["Right Arm"].Transparency = 0
		else
			heman["LeftUpperArm"].Transparency = 0
			heman["LeftLowerArm"].Transparency = 0
			heman["RightUpperArm"].Transparency = 0
			heman["RightLowerArm"].Transparency = 0
		end
	end
end)
