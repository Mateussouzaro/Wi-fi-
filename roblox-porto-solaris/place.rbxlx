	right.AnchorPoint = Vector2.new(1, 0)
	right.Position = UDim2.new(1, -12, 0, 0)
	right.Parent = holders

	return container
end]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBXF000000000000000000000000000A"><Properties><bool name="DefinesCapabilities">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Dropdown</string><string name="ScriptGuid">{053DCC6F-F0F4-4440-9F30-D9E39433CDB5}</string><ProtectedString name="Source"><![CDATA[return function(icon)
	
