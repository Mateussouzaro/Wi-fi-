local m = script.Parent.Parent.Parent.SS.Motor

script.Parent.MouseClick:connect(function(p)
if m.DesiredAngle == 0 then
	m.DesiredAngle = 1
	script.Parent.Parent.DoorOpen:Play()
elseif m.DesiredAngle == 1 then
	m.DesiredAngle = 0
	while m.CurrentAngle > 0 do wait() end
	script.Parent.Parent.DoorClose:Play()
end
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Sound" referent="RBXV060000000000000000000000000014"><Properties><bool name="DefinesCapabilities">false</bool><float name="EmitterSize">10.0</float><NumberRange name="LoopRegion">0.0 60000.0 </NumberRange><bool name="Looped">false</bool><string name="Name">DoorOpen</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0.0 60000.0 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1.0</float><bool name="Playing">false</bool><token name="RollOffMode">0</token><Ref name="SoundGroup">null</Ref><Content name="SoundId"><url>http://www.roblox.com/asset/?id=142897419</url></Content><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0.0</double><float name="Volume">0.5</float><float name="xmlRead_MaxDistance_3">10000.0</float></Properties></Item><Item class="Sound" referent="RBXV060000000000000000000000000015"><Properties><bool name="DefinesCapabilities">false</bool><float name="EmitterSize">10.0</float><NumberRange name="LoopRegion">0.0 60000.0 </NumberRange><bool name="Looped">false</bool><string name="Name">DoorClose</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0.0 60000.0 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1.0</float><bool name="Playing">false</bool><token name="RollOffMode">0</token><Ref name="SoundGroup">null</Ref><Content name="SoundId"><url>http://www.roblox.com/asset/?id=142897445</url></Content><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0.0</double><float name="Volume">0.5</float><float name="xmlRead_MaxDistance_3">10000.0</float></Properties></Item></Item><Item class="Part" referent="RBXV060000000000000000000000000016"><Properties><bool name="Anchored">true</bool><float name="BackParamA">-0.5</float><float name="BackParamB">0.5</float><token name="BackSurface">10</token><