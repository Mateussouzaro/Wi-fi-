local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local MarketplaceService = game:GetService("MarketplaceService")

local Config = require(ReplicatedStorage:WaitForChild("CarSpawnerConfig")).Server

local vehiclesFolder = ServerStorage:WaitForChild("Vehicles")
local vehicleIds = {}
local playerCars = {}
local categories = {}

local AutoDeleteClasses = {
	["Attachment"]		= true;		-- Attachments error if not parented to basepart
    ["PackageLink"]		= true;		-- Cannot change parent of PackageLink
    ["WeldConstraint"]	= true;		-- Constraints often cause issues when reparenting
    ["Motor6D"]			= true;		-- Motor6D joints should be recreated rather than reparented
    ["Bone"]			= true;		-- Bones cannot be reparented between models
    ["UIComponents"]	= true;		-- UI elements often have specific parent requirements
}

local function PrepViewportModel(car)
	local displayCar = car:Clone()
	local driveSeatCframe = nil
	
	if displayCar:FindFirstChild("DriveSeat") then
		driveSeatCframe = displayCar.DriveSeat.CFrame
	end
	
	for _, childName in pairs(Config.AutoDeleteObjects) do
		local object = displayCar:FindFirstChild(childName)
		if object then
			object:Destroy()
		end
	end
	
	for _, object in pairs(displayCar:GetDescendants()) do
		if table.find(Config.ObjectExceptions, object.ClassName) then
			continue
		end
		
		local children = object:GetChildren()
		for _, child in pairs(children) do
			
			if table.find(Config.ObjectExceptions, child.ClassName) then
				continue
			end

			if AutoDeleteClasses[child.ClassName] then
				child:Destroy()
				continue
			end

			local success, err = pcall(function()
				child.Parent = displayCar
			end)

			if not success then
				warn(string.format("Failed to reparent %s (%s): %s", 
					child.Name, 
					child.ClassName, 
					err
				))
				child:Destroy()
			end
		end
		
		if not object:IsA("BasePart") then
			object:Destroy()
			continue
		end
		
		if object.Transparency > Config.TransparencyLimit then
			object:Destroy()
			continue
		end
		
		object.Anchored = true
	end
	
	-- Move car to origin
	local modelCframe = displayCar:GetBoundingBox()
	local centerCframe = driveSeatCframe or modelCframe
	
	local centerBrick = Instance.new("Part")
	centerBrick.Name = "_CenterBrick"
	centerBrick.Anchored = true
	centerBrick.Size = Vector3.one
	centerBrick.Transparency = 0
	
	centerBrick.CFrame = centerCframe
	centerBrick.Position = modelCframe.Position
	centerBrick.Parent = displayCar
	
	displayCar.PrimaryPart = centerBrick
	displayCar:PivotTo(CFrame.new(Vector3.zero, Vector3.new(0,0,-1)))
	
	return displayCar
end

local function SpawnCar(plr, carId)
	if playerCars[plr.UserId] == nil then
		playerCars[plr.UserId] = {}
	end

	local cars = playerCars[plr.UserId]
	if #cars > 0 and os.time() - cars[1].timestamp < Config.SpawnerCooldown then
		return false, "Spawner on cooldown"
	end
	
	if plr.Character == nil then
		return
	end

	if plr.Character.PrimaryPart == nil then
		return
	end
	
	local categoryName = vehicleIds[carId]:GetAttribute("CarCategory")
	if categoryName ~= "Default" and categories[categoryName] ~= nil then
		local info = categories[categoryName]

		if info.CanPlayerSpawn(plr) == false then
			if info.ACCESS == "GAMEPASS" and info.PROMPT_GAMEPASS == true then
				MarketplaceService:PromptGamePassPurchase(plr, info.GAMEPASS_ID)
			end
			return false, "Player cannot access vehicle"
		end
	end

	if #cars >= Config.MaxCarsPerPlayer then
		cars[#cars].car:Destroy()
		cars[#cars] = nil
	end
	
	local newCar = vehicleIds[carId]:Clone() :: Model
	newCar.PrimaryPart = newCar.DriveSeat		-- im incredibly stupid for not realizing this sooner
	newCar.Parent = workspace
	
	-- Thanks to @arrivabus415 for the suggestion
	-- TODO: Fix issue where cars spawn sideways when
	-- model orientation isn't set to 0,0,0 while model is flat
	local carCframe = plr.Character.PrimaryPart.CFrame:ToWorldSpace(CFrame.new(0,0,-Config.SpawnerDistance))
	local _, rotY, _ = carCframe:ToOrientation()
	newCar:PivotTo(CFrame.new(carCframe.Position) * CFrame.Angles(0, rotY + math.rad(180), 0))
	
	local data = {
		car = newCar;
		timestamp = os.time();
	}
	table.insert(cars, 1, data)
	
	return true, Config.SpawnerCooldown
end

local function DeleteCars(plr)
	if playerCars[plr.UserId] == nil then
		return
	end
	
	for _, info in pairs(playerCars[plr.UserId]) do
		info.car:Destroy()
	end
	
	playerCars[plr.UserId] = {}
end

local function Init()
	local displayCarsFolder = Instance.new("Folder")
	displayCarsFolder.Name = "SpawnerViewportModels"
	
	local spawnRemote = Instance.new("RemoteFunction")
	spawnRemote.Name = "SpawnCar"
	spawnRemote.Parent = ReplicatedStorage
	
	local deleteRemote = Instance.new("RemoteEvent")
	deleteRemote.Name = "DeleteCars"
	deleteRemote.Parent = ReplicatedStorage
	
	for _, categoryModule in pairs(ReplicatedStorage:WaitForChild("CarSpawnerCategories"):GetChildren()) do
		if string.sub(categoryModule.Name, 1, 1) == "." then
			continue
		end

		local info = require(categoryModule)
		categories[info.ATTRIBUTE] = info
	end

	for index, car in pairs(vehiclesFolder:GetChildren()) do
		local displayCar = PrepViewportModel(car) :: Model
		displayCar.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		displayCar.Parent = displayCarsFolder
		
		displayCar:SetAttribute("VehicleId", index)
		vehicleIds[index] = car

		local categoryName = car:GetAttribute("CarCategory")
		print(categoryName)

		if categoryName == nil or categoryName == "" then		-- for some reason the "" conditon does not trigger
			car:SetAttribute("CarCategory", "Default")
		else
			if categories[categoryName] == nil then
				warn(
					car.Name .. " with category attribute \"" ..
					categoryName .. "\" does not have category module"
				)
				categories[categoryName] = {
					CanPlayerSpawn = function() return true end
				}
			end
		end
	end
	
	displayCarsFolder.Parent = ReplicatedStorage
	
	spawnRemote.OnServerInvoke = SpawnCar
	deleteRemote.OnServerEvent:Connect(DeleteCars)
	game:GetService("Players").PlayerRemoving:Connect(DeleteCars)
end

Init()]]></ProtectedString><int64 name="SourceAssetId">-1</int64><bool name="Enabled">false</bool></Properties></Item></Item><Item class="StarterPlayer" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">Jogador</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- Porto Solaris — client: cinematic intro, tutorial, garage, driving, speedometer,
-- poses, photo mode, places to discover and notifications.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local SpawnCar = ReplicatedStorage:WaitForChild("SpawnCar")
local Notify = ReplicatedStorage:WaitForChild("Notify")
local Progress = ReplicatedStorage:WaitForChild("Progress")
local catalogueValue = ReplicatedStorage:WaitForChild("Catalogo")
local placesValue = ReplicatedStorage:WaitForChild("Lugares")

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local GOLD = rgb(255, 200, 60)
local DARK = rgb(14, 15, 18)

-- ------------------------------------------------------------------ sounds (built into the client)
local function snd(id, vol)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol
	s.Parent = SoundService
	return s
end
local sClick = snd("rbxasset://sounds/electronicpingshort.wav", 0.35)
local sDone = snd("rbxasset://sounds/button.wav", 0.7)
local sWhoosh = snd("rbxasset://sounds/action_falling.mp3", 0.25)

-- ------------------------------------------------------------------ data from the server
local CARS = {}
for entry in string.gmatch(catalogueValue.Value, "[^;]+") do
	local id, name, price, top, acc, tag = string.match(entry, "([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)")
	table.insert(CARS, { id = id, name = name, price = tonumber(price), top = tonumber(top), acc = tonumber(acc), tag = tag })
end
local PLACES = {}
for entry in string.gmatch(placesValue.Value, "[^;]+") do
	local id, name, x, z = string.match(entry, "([^|]+)|([^|]+)|([^|]+)|([^|]+)")
	table.insert(PLACES, { id = id, name = name, pos = Vector3.new(tonumber(x), 0, tonumber(z)) })
end
local progress = { credits = 0, owned = {}, tutorial = false, found = {} }

-- ------------------------------------------------------------------ UI helpers
local gui = Instance.new("ScreenGui")
gui.Name = "PortoSolaris"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = o
end
local function stroke(o, col, th, tr)
	local s = Instance.new("UIStroke")
	s.Color = col
	s.Thickness = th or 2
	s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = o
end
local function frame(parent, size, pos, color, tr)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color or DARK
	f.BackgroundTransparency = tr or 0.15
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end
local function text(parent, t, size, pos, font, ts, color)
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = t
	l.Font = font or Enum.Font.GothamBold
	l.TextSize = ts or 16
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextWrapped = true
	l.Parent = parent
	return l
end
local function button(parent, t, size, pos, color)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = color or rgb(30, 32, 38)
	b.BackgroundTransparency = 0.05
	b.Text = t
	b.Font = Enum.Font.GothamBlack
	b.TextSize = 16
	b.TextColor3 = Color3.new(1, 1, 1)
	b.AutoButtonColor = true
	b.Parent = parent
	corner(b, 12)
	b.MouseButton1Down:Connect(function()
		sClick:Play()
		local s0 = b.Size
		b.Size = UDim2.new(s0.X.Scale * 0.94, s0.X.Offset * 0.94, s0.Y.Scale * 0.94, s0.Y.Offset * 0.94)
		task.delay(0.08, function() b.Size = s0 end)
	end)
	return b
end
local function slideIn(f, from)
	local goal = f.Position
	f.Position = from
	f.Visible = true
	TweenService:Create(f, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = goal }):Play()
end

-- ------------------------------------------------------------------ toast notifications
local toastHolder = frame(gui, UDim2.new(0, 320, 0, 300), UDim2.new(0.5, -160, 0, 70), DARK, 1)
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Parent = toastHolder
local function toast(msg, color)
	local t = frame(toastHolder, UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, 0), DARK, 0.1)
	corner(t, 20)
	stroke(t, color or GOLD, 2)
	local l = text(t, msg, UDim2.new(1, -20, 1, 0), UDim2.new(0, 10, 0, 0), Enum.Font.GothamBold, 15, color or GOLD)
	l.TextTransparency = 1
	TweenService:Create(l, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
	task.delay(3.5, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(t, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.wait(0.45)
		t:Destroy()
	end)
end

-- ------------------------------------------------------------------ HUD: credits + main buttons
local hud = frame(gui, UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), DARK, 1)
hud.Visible = false
local creditBox = frame(hud, UDim2.new(0, 170, 0, 42), UDim2.new(0, 14, 0, 56), DARK, 0.15)
corner(creditBox, 21)
stroke(creditBox, GOLD, 2)
local creditText = text(creditBox, "💰 0", UDim2.new(1, 0, 1, 0), UDim2.new(0, 0, 0, 0), Enum.Font.GothamBlack, 18, GOLD)
local placeText = text(hud, "", UDim2.new(0, 260, 0, 22), UDim2.new(0, 16, 0, 102), Enum.Font.GothamBold, 13, rgb(200, 210, 220))
placeText.TextXAlignment = Enum.TextXAlignment.Left

local bar = frame(hud, UDim2.new(0, 64, 0, 300), UDim2.new(1, -78, 0.5, -150), DARK, 1)
local barLayout = Instance.new("UIListLayout")
barLayout.Padding = UDim.new(0, 8)
barLayout.Parent = bar
local function sideButton(icon)
	local b = button(bar, icon, UDim2.new(0, 60, 0, 60), UDim2.new(0, 0, 0, 0), rgb(22, 24, 30))
	b.TextSize = 28
	stroke(b, rgb(255, 255, 255), 1.5, 0.6)
	return b
end
local bGarage = sideButton("🚗")
local bPose = sideButton("😎")
local bPhoto = sideButton("📷")
local bHelp = sideButton("❓")

