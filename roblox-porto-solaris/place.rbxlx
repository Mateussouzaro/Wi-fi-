	if Category.ACCESS == "CUSTOM" then
		return true
	end
	return true
end
return Category
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">Esportivos</string><ProtectedString name="Source"><![CDATA[local Category = {}
