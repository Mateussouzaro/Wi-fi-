local RedlineRPM = 7500 -- (Optional) Change the number to your car's redline RPM.


-- More to come soon....




























































--[[

   ___  ____     _  ______  ______  __________  __  _________ __
  / _ \/ __ \   / |/ / __ \/_  __/ /_  __/ __ \/ / / / ___/ // /
