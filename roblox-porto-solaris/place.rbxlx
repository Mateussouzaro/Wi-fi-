local main = script.Parent.Parent
local car = main.CarSeat.Value
local home = script.Parent.Home
local music = script.Parent.Music
local ambience = script.Parent.Ambience
local info = script.Parent.Settings
local apps = home.Apps
local mouse = game.Players.LocalPlayer:GetMouse()

local handler = car:WaitForChild('Filter')

function Home(bool)
	if bool == true then
		home.Apps:TweenPosition(UDim2.new(0,0,-1,0))
		home.Shadow:TweenPosition(UDim2.new(1,0,0.589,0))
	elseif bool == false then
		home.Shadow.Position = UDim2.new(-1,0,0.589,0)
		home.Shadow:TweenPosition(UDim2.new(0.187,0,0.589,0))
		home.Apps:TweenPosition(UDim2.new(0,0,0,0))
	end
end

function Music(bool)
	if bool == true then
		music.Side:TweenPosition(UDim2.new(0,0,0,0))
	elseif bool == false then
		music.Side:TweenPosition(UDim2.new(-0.15,0,0,0))
	end
end

--Inputs

--Main Music window
local radio = false
local custom = false
local sound = car.Parent.Body.Speakers.AudioPart.Sound

function RadioF(bool)
	if bool == true then
		radio = true
		music.Radio.Visible = true
		music.Radio.Position = UDim2.new(-1,0,0,0)
		music.Radio:TweenPosition(UDim2.new(0, 0, 0, 0))
		music.Side.Radio.ImageColor3 = Color3.fromRGB(90,255,90)
	elseif bool == false then
		radio = false
		music.Radio:TweenPosition(UDim2.new(1, 0, 0, 0))
		music.Side.Radio.ImageColor3 = Color3.fromRGB(255,255,255)
	end
end
function CustomF(bool)
	if bool == true then
		custom = true
		music.Custom.Visible = true
		music.Custom.Position = UDim2.new(-0.85,0,0.12,0)
		music.Custom:TweenPosition(UDim2.new(0.15, 0,0.12, 0))
		music.Side.Custom.ImageColor3 = Color3.fromRGB(90,255,90)
	elseif bool == false then --nice !!!!!!
		custom = false
		music.Custom:TweenPosition(UDim2.new(1, 0,0.12, 0))
		music.Side.Custom.ImageColor3 = Color3.fromRGB(255,255,255)
	end
end

apps.Music.MouseButton1Down:Connect(function()
	Home(true)
	Music(true)
	if radio == true then
		music.Radio.Position = UDim2.new(-1,0,0,0)
		music.Radio:TweenPosition(UDim2.new(0, 0, 0, 0))
	end
	if custom == true then
		music.Custom.Position = UDim2.new(-0.85,0,0.12,0)
		music.Custom:TweenPosition(UDim2.new(0.15, 0,0.12, 0))
	end
end)

music.Side.Home.MouseButton1Down:Connect(function()
	Home(false)
	Music(false)
	if radio == true then
		music.Radio:TweenPosition(UDim2.new(1, 0, 0, 0))
	end
	if custom == true then
		music.Custom:TweenPosition(UDim2.new(1, 0,0.12, 0))
	end
end)

music.Side.Radio.MouseButton1Down:Connect(function()
	if radio == false then
		RadioF(true)
		CustomF(false)
		sound:Stop()
		sound.SoundId = ""
	else
		RadioF(false)
		sound:Stop()
		sound.SoundId = ""
	end
end)

music.Side.Custom.MouseButton1Down:Connect(function()
	if custom == false then
		CustomF(true)
		RadioF(false)
		sound:Stop()
		sound.SoundId = ""
	else
		CustomF(false)
		sound:Stop()
		sound.SoundId = ""
	end
end)

--Radio window
--hover functions
nsph = false
kiish = false
rblxh = false

--radio bool values
nsp = false
kiis = false
rblx = false

music.Radio.NSP.MouseEnter:Connect(function()
	nsph = true
end)
music.Radio.NSP.MouseLeave:Connect(function()
	if nsp == false then
		nsph = false
	end
end)
music.Radio.NSP.MouseButton1Down:Connect(function()
	if nsp == false then
		nsp = true
		kiis = false
		rblx = false

		kiish = false
		rblxh = false
		handler:FireServer("fm", 1)
		music.Radio.Label.Text = "Station Playing: Non-Stop Pop"
		handler:FireServer("UpdateInfo", music.Radio.Label.Text)
	else
		handler:FireServer("fm", 0)
		nsp = false
		music.Radio.Label.Text = "Select a Station"
		handler:FireServer("UpdateInfo", "Currently playing: Nothing!")
	end
end)

music.Radio.KIIS.MouseEnter:Connect(function()
	kiish = true
end)
music.Radio.KIIS.MouseLeave:Connect(function()
	if kiis == false then
		kiish = false
	end
end)
music.Radio.KIIS.MouseButton1Down:Connect(function()
	if kiis == false then
		nsp = false
		kiis = true
		rblx = false

		nsph = false
		rblxh = false
		handler:FireServer("fm", 2)
		music.Radio.Label.Text = "Station Playing: KIIS FM"
		handler:FireServer("UpdateInfo", music.Radio.Label.Text)
	else
		handler:FireServer("fm", 0)
		kiis = false
		music.Radio.Label.Text = "Select a Station"
		handler:FireServer("UpdateInfo", "Currently playing: Nothing!")
	end
end)

music.Radio.RBLX.MouseEnter:Connect(function()
	rblxh = true
end)
music.Radio.RBLX.MouseLeave:Connect(function()
	if rblx == false then
		rblxh = false
	end
end)
music.Radio.RBLX.MouseButton1Down:Connect(function()
	if rblx == false then
		nsp = false
		kiis = false
		rblx = true

		nsph = false
		kiish = false
		handler:FireServer("fm", 3)
		music.Radio.Label.Text = "Station Playing: Roblox Playlist"
		handler:FireServer("UpdateInfo", music.Radio.Label.Text)
	else
		handler:FireServer("fm", 0)
		rblx = false
		music.Radio.Label.Text = "Select a Station"
		handler:FireServer("UpdateInfo", "Currently playing: Nothing!")
	end
end)

--Custom ID window
local paused = false

music.Custom.P.MouseButton1Down:Connect(function()
	local soundName = game:GetService("MarketplaceService"):GetProductInfo(music.Custom.Input.Text).Name

	if paused == false then
		handler:FireServer("Sound", music.Custom.Input.Text)
		music.Custom.TextLabel.Text = "Currently playing: "..soundName
		handler:FireServer("UpdateInfo", music.Custom.TextLabel.Text)
	else
		paused = false
		handler:FireServer("SoundResume")
	end
end)

music.Custom.S.MouseButton1Down:Connect(function()
	handler:FireServer("SoundStop")
	music.Custom.TextLabel.Text = "Currently playing: Nothing!"
	handler:FireServer("UpdateInfo", music.Custom.TextLabel.Text)
end)

music.Custom.ST.MouseButton1Down:Connect(function()
	if paused == false then
		paused = true
		handler:FireServer("SoundPause")
	end
end)

local progress = music.Custom.bar.progress
local bar = music.Custom.bar
local line = music.Custom.bar.line

local lmb = false

mouse.Button1Down:connect(function()
	lmb = true
end)

mouse.Button1Up:connect(function()
	lmb = false
end)

game:GetService("RunService"):BindToRenderStep("mp3player", 100, function()
	progress.Size = UDim2.new(sound.TimePosition /sound.TimeLength, 0, 1, 0)
	if mouse.X > bar.AbsolutePosition.X and mouse.X < bar.AbsolutePosition.X +bar.AbsoluteSize.X and
		mouse.Y > bar.AbsolutePosition.Y -bar.BorderSizePixel and mouse.Y < bar.AbsolutePosition.Y +bar.AbsoluteSize.Y +bar.BorderSizePixel then
		line.Size = UDim2.new(0, mouse.X -bar.AbsolutePosition.X, 1, 0)
		if lmb then
			local continue = sound.IsPlaying
			handler:FireServer("SoundPause")
			sound.TimePosition = sound.TimeLength *(mouse.X -bar.AbsolutePosition.X) /bar.AbsoluteSize.X
			if continue then
				repeat
					wait()
				until not lmb
				handler:FireServer("SoundResume")
			end
		end
	else
		line.Size = UDim2.new()
	end
end)

music.Custom.SE.MouseButton1Down:Connect(function()
	music.Settings.Visible = true
end)

--settings menu
local volumev = music.Volume
local pitchv = music.Pitch

music.Settings.Back.MouseButton1Down:Connect(function()
	music.Settings.Visible = false
end)

music.Settings.Volume_Adjust.Raise.MouseButton1Down:Connect(function()
	if volumev.Value < 10 then
		volumev.Value = volumev.Value + 0.5
		music.Settings.Volume_Adjust.Value.Text = volumev.Value
		handler:FireServer("Volume", volumev.Value)
	end
end)
music.Settings.Volume_Adjust.Lower.MouseButton1Down:Connect(function()
	if volumev.Value > 0 then
		volumev.Value = volumev.Value - 0.5
		music.Settings.Volume_Adjust.Value.Text = volumev.Value
		handler:FireServer("Volume", volumev.Value)
	end
end)

music.Settings.Pitch_Adjust.Raise.MouseButton1Down:Connect(function()
	if pitchv.Value < 10 then
		pitchv.Value = pitchv.Value + 0.5
		music.Settings.Pitch_Adjust.Value.Text = pitchv.Value
		handler:FireServer("Pitch", pitchv.Value)
	end
end)
music.Settings.Pitch_Adjust.Lower.MouseButton1Down:Connect(function()
	if pitchv.Value > 0 then
		pitchv.Value = pitchv.Value - 0.5
		music.Settings.Pitch_Adjust.Value.Text = pitchv.Value
		handler:FireServer("Pitch", pitchv.Value)
	end
end)

--ambience
local colors = ambience.Colors.Colors
local fw = false

apps.Ambient.MouseButton1Down:Connect(function()
	if ambience.B.Value == false then
		Home(true)
		ambience.B.Value = true
		local Info = TweenInfo.new(1)
		local t = game:GetService("TweenService"):Create(ambience.Power,Info,{ImageTransparency=0})
		t:Play()
		local t = game:GetService("TweenService"):Create(ambience.Home,Info,{ImageTransparency=0})
		t:Play()
		if ambience.On.Value == true then
			ambience.Colors.Colors:TweenPosition(UDim2.new(0,0,0,0))
			ambience.Options.Options:TweenPosition(UDim2.new(0,0,0,0))
		end
	end
end)

ambience.Home.MouseButton1Down:Connect(function()
	if ambience.B.Value == true then
		ambience.B.Value = false
		local Info = TweenInfo.new(1)
		local t = game:GetService("TweenService"):Create(ambience.Power,Info,{ImageTransparency=1})
		t:Play()
		local t = game:GetService("TweenService"):Create(ambience.Home,Info,{ImageTransparency=1})
		t:Play()
		ambience.Colors.Colors:TweenPosition(UDim2.new(1,0,0,0))
		ambience.Options.Options:TweenPosition(UDim2.new(-1,0,0,0))
		Home(false)
	end
end)

ambience.Power.MouseButton1Click:Connect(function()
	if ambience.B.Value == true then
		if ambience.On.Value == false then
			ambience.On.Value = true
			ambience.Power.ImageColor3 = Color3.new(0,255,0)
			ambience.Colors.Colors:TweenPosition(UDim2.new(0,0,0,0))
			ambience.Options.Options:TweenPosition(UDim2.new(0,0,0,0))
			handler:FireServer('colors', 'dash', colors.Blue.ImageColor3)
			handler:FireServer('GradientTransparency', 0.5)
			if fw == true then
				handler:FireServer('ambient', 'footwell', true)
			end
		else
			ambience.On.Value = false
			ambience.Power.ImageColor3 = Color3.new(255,0,0)
			handler:FireServer('ambient', 'dash', false)
			ambience.Colors.Colors:TweenPosition(UDim2.new(1,0,0,0))
			ambience.Options.Options:TweenPosition(UDim2.new(-1,0,0,0))
			handler:FireServer('ambient', 'footwell', false)
			handler:FireServer('colors', 'dash', Color3.fromRGB(179,179,179))
			handler:FireServer('GradientTransparency', 0.86)
		end
	end
end)

ambience.Options.Options.Power.MouseButton1Click:Connect(function()
	if ambience.On.Value == true then
		if fw == false then
			handler:FireServer('ambient', 'footwell', true)
			fw = true
		else
			handler:FireServer('ambient', 'footwell', false)
			fw = false
		end
	end
end)

colors.Red.MouseButton1Click:Connect(function()
	handler:FireServer('colors', colors.Red.ImageColor3)
	handler:FireServer('colors', 'dash', colors.Red.ImageColor3)
	handler:FireServer('colors', 'footwell', colors.Red.ImageColor3)
end)

colors.Blue.MouseButton1Click:Connect(function()
	handler:FireServer('colors', colors.Blue.ImageColor3)
	handler:FireServer('colors', 'dash', colors.Blue.ImageColor3)
	handler:FireServer('colors', 'footwell', colors.Blue.ImageColor3)
end)

colors.Green.MouseButton1Click:Connect(function()
	handler:FireServer('colors',  colors.Green.ImageColor3)
	handler:FireServer('colors', 'dash', colors.Green.ImageColor3)
	handler:FireServer('colors', 'footwell', colors.Green.ImageColor3)
end)

colors.Orange.MouseButton1Click:Connect(function()
	handler:FireServer('colors', colors.Orange.ImageColor3)
	handler:FireServer('colors', 'dash', colors.Orange.ImageColor3)
	handler:FireServer('colors', 'footwell', colors.Orange.ImageColor3)
end)

colors.Purple.MouseButton1Click:Connect(function()
	handler:FireServer('colors', colors.Purple.ImageColor3)
	handler:FireServer('colors', 'dash', colors.Purple.ImageColor3)
	handler:FireServer('colors', 'footwell', colors.Purple.ImageColor3)
end)

colors.Yellow.MouseButton1Click:Connect(function()
	handler:FireServer('colors', colors.Yellow.ImageColor3)
	handler:FireServer('colors', 'dash', colors.Yellow.ImageColor3)
	handler:FireServer('colors', 'footwell', colors.Yellow.ImageColor3)
end)

--car settings menu
TweenService = game:GetService("TweenService")
local interface = script.Parent.Parent.Parent:WaitForChild('A-Chassis Interface')
local ui = interface:WaitForChild("COLTUI V2")

local setw = true
local infow = false

apps.Info.MouseButton1Down:Connect(function()
	if info.B.Value == false then
		Home(true)
		info.B.Value = true
		info.Options:TweenPosition(UDim2.new(0,0,0,0))
		info.Settings:TweenPosition(UDim2.new(0,0,0,0))
	end
end)

info.Options.Home.MouseButton1Down:Connect(function()
	if info.B.Value == true then
		info.B.Value = false
		Home(false)
		setw = true
		infow = false
		info.Options:TweenPosition(UDim2.new(0,0,-0.208,0))
		info.Settings:TweenPosition(UDim2.new(0,0,1,0))
		info.Info:TweenPosition(UDim2.new(0,0,1,0))
	end
end)

local AA = TweenService:Create(info.Settings.AutoAlign.Info.Label, TweenInfo.new(5, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {Position = UDim2.new(-0.991,0,0,0)})

info.Settings.AutoAlign.MouseEnter:Connect(function()
	AA:Play()
end)
info.Settings.AutoAlign.MouseLeave:Connect(function()
	AA:Cancel()
	info.Settings.AutoAlign.Info.Label.Position = UDim2.new(0,0,0,0)
end)
info.Settings.AutoAlign.Switch.TextButton.MouseButton1Down:Connect(function()
	if car.Values.AA.Value == false then
