print("EpicLights V4: SpotLights // Handler setup completed")
-- functions
function doTween(i, ti, pt)
	TweenService:Create(i, ti, pt):Play()
end

function updatelights(model: Model, spotbr: number, br: number?, tp: number?, rng: number?)
	br = br or 0
	for i, v in pairs(model:GetDescendants()) do
		if v.Name == "L" and v:IsA("Light") then
			doTween(v, selected_TI, {Brightness = br})
			if rng ~= nil then
				v.Range = rng
			end
		elseif v.Name == "LN" then
			doTween(v.LN_S, selected_TI, {Brightness = spotbr})
		elseif v.Name == "LN_M" or v.Name == "LN_N" then
			doTween(v, selected_TI, {Transparency = tp})
		end
	end
end

function sequentialsequence(model: Model, val: boolean)
	if val then
		for i = 1, config.SequentialAmount do
			for id, v in pairs(model:GetDescendants()) do
				if v.Name == "SI"..i then
					doTween(v.LN_S, selected_TI, {Transparency = 0.02})
				end	
			end	
			task.wait(config.IndicatorFlashRate / config.SequentialAmount)
		end
	else
		for i, v in pairs(model:GetDescendants()) do
			if string.sub(v.Name, 1, 2) == "SI" then
				doTween(v.LN_S, selected_TI, {Transparency = 1})
			end
		end
	end	
end

function indicatorIllum(spotbr, tp)
	updatelights(lights.Indicators.LeftInd.Front, spotbr, 0, tp)
	updatelights(lights.Indicators.LeftInd.Side, spotbr, 0, tp)
	updatelights(lights.Indicators.RightInd.Front, spotbr, 0, tp)
	updatelights(lights.Indicators.RightInd.Side, spotbr, 0, tp)
end

local otp = {1, 0}
local iotp = {1, 0}

local checks = {
	["TrunkLights"] = {
		val = config.TrunkLights,
		callback = function(t, s, spotbr, tp, b)
			if s ~= nil then
				updatelights(trunk[t][s], spotbr, b, tp)
			else
				updatelights(trunk[t], spotbr, b, tp)
			end
		end
	},
	["Reflectors"] = {
		val = config.IlluminatedReflectors,
		callback = function(spotbr, tp)
			iotp[1] = tp
			iotp[2] = spotbr
			indicatorIllum(spotbr, tp)
			updatelights(lights.Reflectors, spotbr, 0, tp)
		end
	},
	["PlateLights"] = {
		val = config.PlateLights,
		callback = function(spotbr, tp, b)
			updatelights(lights.Plate, spotbr, b, tp)
		end
	},
	["Popups"] = {
		val = config.PopupsEnabled,
		callback = function(spotbr, tp, b, rng)
			updatelights(popups.Parts.Headlights, spotbr, b, tp, rng)
		end
	},
	["DoorIndicators"] = {
		val = config.DoorIndicators,
		callback = function(t, tp, spotbr)
			updatelights(t.Indicators, spotbr, 0, tp)
		end
	},
	["SequentialIndicators"] = {
		val = config.SequentialIndicators,
		callback = function(t, bool)
			task.spawn(sequentialsequence, t, bool)
		end
	}
}

function doCheck(ct, t, tp, b, tp2, ex)
	pcall(function()
		if not checks[ct].val then return end
		checks[ct].callback(t, tp, b, tp2, ex)	
	end)
end

-- light functions
F.Lights = function(val, runningval)
	values.Lights.Value = val or values.Lights.Value
	if runningval ~= nil then
		values.Running.Value = runningval
		if config.RunningHeadlight then
			if values.Running.Value then
				otp[1] = 0.27
				otp[2] = config.RunningSpotBright
				if config.IlluminatedReflectors then
					iotp[1] = 0.27
					iotp[2] = config.IndicatorSpotBright / 2
				end
			else 
				otp[1] = 1
				iotp[1] = 1
				otp[2] = 0
				iotp[2] = 0
			end
		else
			if values.Running.Value then
				updatelights(lights.Headlights.Running, config.RunningSpotBright, config.RunningLightBrightness, 0.27)
				if config.IlluminatedReflectors then
					iotp[1] = 0.27
					iotp[2] = config.IndicatorSpotBright / 2
				end
			else
				updatelights(lights.Headlights.Running, 0, 0, 1)
				if config.IlluminatedReflectors then
					iotp[1] = 1
					iotp[2] = 0
				end
			end
		end	
	end	
	if values.Lights.Value == 0 then
		if values.Running.Value and config.IlluminatedReflectors then
			iotp[1] = 0.27
			iotp[2] = config.IndicatorSpotBright / 2
		else
			iotp[1] = 1
			iotp[2] = 0
		end
		-- updatelights(model: Model, spotbr: number, br: number?, tp: number?, rng: number?)
		doCheck("Reflectors", iotp[2], iotp[1])
		doCheck("PlateLights", 0, 1, 0)
		doCheck("Popups", otp[2], otp[1], 0, 48)
		doCheck("TrunkLights", "Rear", nil, 0, 1, 0)
		updatelights(lights.Headlights.Low, otp[2], 0, otp[1], 48)
		updatelights(lights.Headlights.High, 0, 0, 1)
		updatelights(lights.Rear, 0, 0, 1)
	elseif values.Lights.Value == 1 then
		doCheck("Reflectors", config.RunningSpotBright, 0.27)
		doCheck("PlateLights", config.PlateSpotBright, 0.02, 1)
		doCheck("Popups", config.LowBeamSpotBright, 0.2, config.LowBeamBrightness, 48)
		doCheck("TrunkLights", "Rear", nil, config.RearLightBrightness, 0.2, config.RearSpotBright)
		updatelights(lights.Headlights.Low, config.LowBeamSpotBright, config.LowBeamBrightness, 0.2, 48)
		updatelights(lights.Headlights.High, 0, 0, 1)
		updatelights(lights.Rear, config.RearSpotBright, config.RearLightBrightness, 0.2)
	elseif values.Lights.Value == 2 then
		doCheck("Popups", config.LowBeamSpotBright, 0.2, config.LowBeamBrightness, 48)
		updatelights(lights.Headlights.Low, config.HighBeamSpotBright, config.HighBeamBrightness, 0.02, 60)
		updatelights(lights.Headlights.High, config.HighBeamSpotBright, config.HighBeamBrightness, 0.02)
	end
end

F.Flash = function(val)
	if values.Lights.Value ~= 2 then
		if val then
			doCheck("Popups", config.HighBeamSpotBright, 0.02, config.HighBeamBrightness, 60)
			updatelights(lights.Headlights.Low, config.HighBeamSpotBright, config.HighBeamBrightness, 0.02, 60)
			updatelights(lights.Headlights.High, config.HighBeamSpotBright, config.HighBeamBrightness, 0.02)
		else
			F.Lights()
		end
	end
end

F.Fogs = function(val, override)
	values.Fogs.Value = val
	if values.Fogs.Value and values.Lights.Value > 0 and not override then
		updatelights(lights.Fog, config.FogSpotBright, config.FogLightBrightness, 0.02)
	elseif not values.Fogs.Value or override then
		updatelights(lights.Fog, 0, 0, 1)
	end
end

F.Brake = function(val)
	if val then
		doCheck("TrunkLights", "Brake", nil, config.BrakeLightBrightness, 0.02, config.BrakeSpotBright)
		updatelights(lights.Brake, config.BrakeSpotBright, config.BrakeLightBrightness, 0.02)
	else
		doCheck("TrunkLights", "Brake", nil, 0, 1, 0)
		updatelights(lights.Brake, 0, 0, 1)
	end
end

F.Reverse = function(val)
	if val then
		doCheck("TrunkLights", "Reverse", nil, config.ReverseLightBrightness, 0.02, config.ReverseSpotBright)
		updatelights(lights.Reverse, config.ReverseSpotBright, config.ReverseLightBrightness, 0.02)
	else
		doCheck("TrunkLights", "Reverse", 1, 0)
		updatelights(lights.Reverse, 0, 0, 1)
	end
end

F.Signal = function(type, val)
	for i, v in pairs(values.Indicators:GetChildren()) do
		if v.Name == type then
			v.Value = val
		else
			v.Value = false
		end
	end
end

F.Popups = function(val)
	values.Popups.Value = val
	if config.PopupHingeType == "Single" and config.PopupsEnabled then
		local motor = popups.Hinge.Motor
		if values.Popups.Value then
			motor.DesiredAngle = config.PopupHingeAngle
		else
			motor.DesiredAngle = 0
		end
	elseif config.PopupHingeType == "Dual" and config.PopupsEnabled then
		local motor1 = popups.Hinge1.Motor
		local motor2 = popups.Hinge2.Motor
		if values.Popups.Value then
			motor1.DesiredAngle = config.PopupHingeAngle
			motor2.DesiredAngle = config.PopupHingeAngle
		else
			motor1.DesiredAngle = 0
			motor2.DesiredAngle = 0
		end
	end
end
-- signal loop
task.spawn(function()
	while wait() do
		if values.Indicators.Left.Value then
			doCheck("TrunkLights", "Indicators", "LeftInd", 1, 0.02, config.IndicatorSpotBright)
			doCheck("DoorIndicators", door_FL, 0.02, config.IndicatorSpotBright)
			doCheck("SequentialIndicators", lights.Indicators.LeftInd, true)
			updatelights(lights.Indicators.LeftInd, config.IndicatorSpotBright, 1, 0.02)
			task.wait(config.IndicatorFlashRate)
			doCheck("TrunkLights", "Indicators", "LeftInd", 0, 1, 0)
			doCheck("DoorIndicators", door_FL, 1, 0)
			doCheck("SequentialIndicators", lights.Indicators.LeftInd, false)
			updatelights(lights.Indicators.LeftInd.Front, iotp[2], 0, iotp[1])
			updatelights(lights.Indicators.LeftInd.Side, iotp[2], 0, iotp[1])
			updatelights(lights.Indicators.LeftInd.Rear, 0, 0, 1)
			task.wait(config.IndicatorFlashRate)
		end
		if values.Indicators.Right.Value then
			doCheck("TrunkLights", "Indicators", "RightInd", 1, 0.02, config.IndicatorSpotBright)
			doCheck("DoorIndicators", door_FR, 0.02, config.IndicatorSpotBright)
			doCheck("SequentialIndicators", lights.Indicators.RightInd, true)
			updatelights(lights.Indicators.RightInd, config.IndicatorSpotBright, 1, 0.02)
			task.wait(config.IndicatorFlashRate)
			doCheck("TrunkLights", "Indicators", "RightInd", 0, 1, 0)
			doCheck("DoorIndicators", door_FR, 1, 0)
			doCheck("SequentialIndicators", lights.Indicators.RightInd, false)
			updatelights(lights.Indicators.RightInd.Front, iotp[2], 0, iotp[1])
			updatelights(lights.Indicators.RightInd.Side, iotp[2], 0, iotp[1])
			updatelights(lights.Indicators.RightInd.Rear, 0, 0, 1)
			task.wait(config.IndicatorFlashRate)
		end
		if values.Indicators.Hazard.Value then
			doCheck("TrunkLights", "Indicators", nil, 1, 0.02, config.IndicatorSpotBright)
			doCheck("DoorIndicators", door_FL, 0.02, config.IndicatorSpotBright)
			doCheck("DoorIndicators", door_FR, 0.02, config.IndicatorSpotBright)
			doCheck("SequentialIndicators", lights.Indicators, true)
			updatelights(lights.Indicators, config.IndicatorSpotBright, 1, 0.02)
			task.wait(config.IndicatorFlashRate)
			doCheck("TrunkLights", "Indicators", nil, 0, 1, 0)
			doCheck("DoorIndicators", door_FL, 1, 0)
			doCheck("DoorIndicators", door_FR, 1, 0)
			doCheck("SequentialIndicators", lights.Indicators, false)
			indicatorIllum(iotp[2], iotp[1])
			updatelights(lights.Indicators.LeftInd.Rear, 0, 0, 1)
			updatelights(lights.Indicators.RightInd.Rear, 0, 0, 1)
			task.wait(config.IndicatorFlashRate)
		end
	end
end)

if config.InteriorLights then
	local center_override = false
	local front_override = false
	local door_open = false
	local int_triggers = car.Body:FindFirstChild("InteriorTriggers")
	local event1 = int_triggers:FindFirstChild("OverrideTriggers")
	if #doors > 0 and config.DoorFunctionality then
		for i, v in pairs(doors) do
			local event2 = v:FindFirstChild("LightsDoor")
			event2.Event:Connect(function(s)
				door_open = s
				if s then
					if not center_override then
						updatelights(lights.Interior.Center, 0.02, 0.38)
					end
					if not front_override then
						updatelights(lights.Interior.Front, 0.02, 0.38)
					end
				else
					if not center_override then
						updatelights(lights.Interior.Center, 1, 0)
					end
					if not front_override then
						updatelights(lights.Interior.Front, 1, 0)
					end
				end
			end)
		end
	end	
	event1.Event:Connect(function(s, t)
		if t == "Center" then
			center_override = s
			if not door_open then
				if s then
					updatelights(lights.Interior.Center, 0, 0.38, 0.02)
				else
					updatelights(lights.Interior.Center, 0, 0, 1)
				end
			end	
		elseif t == "Front" then
			front_override = s
			if not door_open then
				if s then
					updatelights(lights.Interior.Front, 0.02, 0.38)
				else
					updatelights(lights.Interior.Front, 1, 0)
				end	
			end
		end	
	end)	
end	



script.Parent.OnServerEvent:Connect(function(plr, Fnc, ...)
