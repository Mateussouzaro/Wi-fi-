l></Properties></Item><Item class="BoolValue" referent="RBXV0300000000000000000000000003BD"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Fogs</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item></Item></Item><Item class="LocalScript" referent="RBXV0300000000000000000000000003BE"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">EpicLights</string><token name="RunContext">0</token><string name="ScriptGuid">{BCDF8ED7-8779-4096-AFBE-6741BC01803C}</string><ProtectedString name="Source"><![CDATA[--[[

