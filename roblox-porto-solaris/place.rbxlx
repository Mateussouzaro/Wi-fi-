_Tune = require(Car["A-Chassis Tune"])

local Values = script.Parent.Parent.Values

local mouse = game.Players.LocalPlayer:GetMouse()

--Adjustable Values
local clutch = 0.943 			-- Set this value anywhere between 0 to 1. Use an RPM reader to accurately check which RPM your car will launch at. Not necessary, but recommended.
local timelimit = 5			-- How long launch control will last once engaged, in seconds. Once the time limit is reached, launch control will be automatically disabled.
local clutchdelay = 0.2		-- Delays the clutch engagement, in seconds, after either the parking brake is removed or the gear is changed.

--End of adjustable values. Don't touch anything below, unless you know what you're doing.
_Tune.ClutchKick = false

local launchenabled = false
script.Parent.Auto.MouseButton1Click:Connect(function()
	if not Values.AutoClutch.Value then
		local GPos = (mouse.ViewSizeX*0.5)-205
		Values.Clutch.Value = 1-(.01*(mouse.X-GPos))
	end
end)

script.Parent.MouseButton1Click:Connect(function()
	if Values.Gear.Value == 0 then
		Values.AutoClutch.Value = false
		Values.Clutch.Value = clutch
		_Tune.ClutchKick = true
		launchenabled = true
		wait (timelimit)
		Values.AutoClutch.Value = true
		launchenabled = false
	elseif Values.PBrake.Value == true and Values.Gear.Value == 1 then
		Values.AutoClutch.Value = false
		Values.Clutch.Value = clutch
		_Tune.ClutchKick = true
		launchenabled = true
		wait (timelimit)
		Values.AutoClutch.Value = true
		_Tune.ClutchKick = false
		launchenabled = false
	else
		Values.AutoClutch.Value = true
		_Tune.ClutchKick = false
		launchenabled = false
	end
end)

Values.Gear.Changed:connect(function()
	if launchenabled == true then
		wait (clutchdelay)
		Values.AutoClutch.Value = true
		_Tune.ClutchKick = false
		launchenabled = false
	end
end)

Values.PBrake.Changed:connect(function()
	if Values.PBrake.Value == false then
		if launchenabled == true then
			wait (clutchdelay)
			Values.AutoClutch.Value = true
			_Tune.ClutchKick = false
			launchenabled = false
		end
	end
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="TextButton" referent="RBXV070000000000000000000000000310"><Properties><bool name="Active">true</bool><Vector2 name="AnchorPoint"><X>0.0</X><Y>0.0</Y></Vector2><bool name="AutoButtonColor">true</bool><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><float name="BackgroundTransparency">1.0</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">1</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><float name="LineHeight">1.0</float><string name="LocalizationMatchIdentifier"></string><string name="LocalizationMatchedSourceText"></string><int name="MaxVisibleGraphemes">-1</int><bool name="Modal">false</bool><string name="Name">Custom Start Button</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><string name="OpenTypeFeatures"></string><UDim2 name="Position"><XS>0.6472843885421753</XS><XO>0</XO><YS>0.8826252222061157</YS><YO>0</YO></UDim2><bool name="RichText">false</bool><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0.0</float><bool name="Selectable">true</bool><bool name="Selected">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><UDim2 name="Size"><XS>0.04589303582906723</XS><XO>0</XO><YS>0.07235876470804214</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">6083162423</int64><token name="Style">0</token><string name="Text"></string><Color3 name="TextColor3"><R>0.0</R><G>0.0</G><B>0.0</B></Color3><token name="TextDirection">0</token><bool name="TextScaled">false</bool><float name="TextSize">14.0</float><Color3 name="TextStrokeColor3"><R>0.0</R><G>0.0</G><B>0.0</B></Color3><float name="TextStrokeTransparency">1.0</float><float name="TextTransparency">0.0</float><token name="TextTruncate">0</token><bool name="TextWrapped">false</bool><token name="TextXAlignment">2</token><token name="TextYAlignment">1</token><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties><Item class="LocalScript" referent="RBXV070000000000000000000000000311"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">LocalScript</string><token name="RunContext">0</token><string name="ScriptGuid">{2D1B5052-F74F-493B-A984-FCDA8816DB64}</string><ProtectedString name="Source"><![CDATA[wait(0.2) -- Removing this could break the script.
-- Variables (dont mess with unless you want to change an items location or something)
local RemoteEvent = script.Sound
local value = script.Parent.Parent.IsOn.Value
local A = script.Parent.Icon.Icon.A
local B = script.Parent.Icon.Icon.B
local text = script.Parent
function leftClick() -- detect leftclick
------------------------------------------------------------------------------------------------------------------
	-- Settings
	
	local delay = 2.5
		
	------------------------------------------------------------------------------------------------------------------
	-- this bundle of code is to check if the car is on or whatever... pretty simple, wrote it in 5 seconds
	if script.Parent.Parent.IsOn.Value == false
	then

		B.Visible = true
		A.Visible = false
		-- Tell the remote event to fire
		RemoteEvent:FireServer()
		wait (delay) -- adds some time before the engine turns on to prevent the engine idle playing over the startup, makes it sound better
		script.Parent.Parent.IsOn.Value = true

	else

		B.Visible = false
		A.Visible = true
		script.Parent.Parent.IsOn.Value = false
		-- no remote event needed here, we dont want the start sound playing when we shut off the engine now, do we?
		
	end
	
end
script.Parent.MouseButton1Click:Connect(leftClick) -- close leftclick (lua is annoying sometimes aa)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="RemoteEvent" referent="RBXV070000000000000000000000000312"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Sound</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV070000000000000000000000000313"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Script</string><token name="RunContext">0</token><string name="ScriptGuid">{37498520-B364-47AF-85D6-3AF7D1EF26B0}</string><ProtectedString name="Source"><![CDATA[local RemoteEvent = script.Parent
local sound = script.Parent.Parent.Parent.Icon.Start
