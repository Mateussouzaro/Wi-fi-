local TYPECHECKING = require(script.Typechecks)
local CONFIG: TYPECHECKING.CONFIG = {
	Client = {
		
		ListPadding = 25;			-- Pixel spacing between buttons in list view
		GridColumns = 4;			-- Button columns in grid view (warning: more columns lowers framerate)
		GridPadding = 15;			-- Pixel spacing between buttons in grid view
		
		ViewportCameraAngle = 225;	-- Camera angle, in degrees, when viewing cars in gui
		RotationTime = 5;			-- Time, in seconds, for the car to make a full rotation when hovering over its button
		ReturnTime = 2.5;			-- Time, in seconds, for the car to rotate back to its original orientation when the mouse leaves its button
		DefaultFov = 30;			-- Field of view of the viewport frame of a car button
		HoverFov = 25;				-- Field of view of the viewport frame when hovering over a car button
		
	};
	
	Server = {
		
		SpawnerCooldown = 10;		-- Time, in seconds, before a player can spawn another car
		MaxCarsPerPlayer = 1;		-- Maximum amount of cars that can be spawned at once by each player
		SpawnerDistance = 15;		-- Distance, in studs, where the car gets spawned in front of the player
		
		--Viewport vehicle optimization
		TransparencyLimit = 0.8;	-- Any cars containing parts with transparency above this limit will be removed
		AutoDeleteObjects = {		-- Any objects in the ROOT DIRECTORY of the car model to be deleted instantly
			"A-Chassis Tune";
			"Tuner";
		};
		ObjectExceptions = {		-- Object classes that will not be deleted
			"CylinderMesh";
			"Decal";
			"Texture";
			"SurfaceAppearance";
		}
		
	};
}

return CONFIG
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBXF000000000000000000000000001D"><Properties><bool name="DefinesCapabilities">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Typechecks</string><string name="ScriptGuid">{01E7ECAB-F9C3-4FF1-9EC9-324401F6B5C9}</string><ProtectedString name="Source"><![CDATA[export type CLIENT = {
	
	CategoryOrder: {string};

	ListPadding: number;
	GridColumns: number;
	GridPadding: number;
	
	ViewportCameraAngle: number;
	RotationTime: number;
	ReturnTime: number;
	DefaultFov: number;
	HoverFov: number;
}

export type SERVER = {
	SpawnerCooldown: number;
	MaxCarsPerPlayer: number;
	SpawnerDistance: number;
	
	TransparencyLimit: number;
	AutoDeleteObjects: { [number]: string };
	ObjectExceptions: { [number]: string };
}

export type CONFIG = {
	Client: CLIENT;
	Server: SERVER;
}

return nil]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">CarSpawnerCategories</string></Properties><Item class="ModuleScript" referent="RBXF000000000000000000000000001F"><Properties><bool name="DefinesCapabilities">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">.CategoryTemplate</string><string name="ScriptGuid">{E2C47C47-2BFB-4709-95BC-79CF1F0C6C1D}</string><ProtectedString name="Source"><![CDATA[local Category = {}

--[[ CONFIG ]]

Category.NAME = "ExampleName"			-- How the category will appear in the menu
Category.ATTRIBUTE = "ExampleCategory"	-- "CarCategory" attribute of car must be set to this

Category.ACCESS = "ALL"					-- "ALL", "GAMEPASS", or "CUSTOM"
Category.HIDDEN = false					-- If player is not allowed to spawn category, can they still view it in the menu?
Category.PRIORITY = 0					-- Determines display order in the menu (increase to show category lower than others)

Category.GAMEPASS_ID = 0000000			-- Only necessary if category is set to gamepass access
Category.PROMPT_GAMEPASS = true			-- Prompt player to purchase gamepass if they do not own it

--[[ END CONFIG ]]

Category.CanPlayerSpawn = function(plr: Player): boolean
	if Category.ACCESS == "CUSTOM" then
		-- Program custom behavior here
	end

	if Category.ACCESS == "GAMEPASS" then
		return game:GetService("MarketplaceService"):UserOwnsGamePassAsync(plr.UserId, Category.GAMEPASS_ID)
	end

	return true
end

return Category]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">Populares</string><ProtectedString name="Source"><![CDATA[local Category = {}
