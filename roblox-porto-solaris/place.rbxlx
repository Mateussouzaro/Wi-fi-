end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="RemoteEvent" referent="RBXV04000000000000000000000000034D"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">ExhaustHandler2</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV04000000000000000000000000034E"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">FlameController2</string><token name="RunContext">0</token><string name="ScriptGuid">{06EFFB4E-3228-420D-9A2E-1F97A6E723F8}</string><ProtectedString name="Source"><![CDATA[
