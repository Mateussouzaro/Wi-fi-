urceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV1100000000000000000000000003B7"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">RunningLights</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV1100000000000000000000000003B8"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Right</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="NumberValue" referent="RBXV1100000000000000000000000003B9"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Headlights</string><int64 name="SourceAssetId">-1</int64><double name="Value">0.0</double></Properties></Item></Item></Item><Item class="Folder" referent="RBXV1100000000000000000000000003BA"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Sounds</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Sound" referent="RBXV1100000000000000000000000003BB"><Properties><bool name="DefinesCapabilities">false</bool><float name="EmitterSize">10.0</float><NumberRange name="LoopRegion">0.0 60000.0 </NumberRange><bool name="Looped">false</bool><string name="Name">TickOn</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0.0 60000.0 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1.0</float><bool name="Playing">false</bool><token name="RollOffMode">0</token><Ref name="SoundGroup">null</Ref><Content name="SoundId"><url>rbxassetid://6212969851</url></Content><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0.0</double><float name="Volume">1.0</float><float name="xmlRead_MaxDistance_3">10000.0</float></Properties></Item><Item class="Sound" referent="RBXV1100000000000000000000000003BC"><Properties><bool name="DefinesCapabilities">fal