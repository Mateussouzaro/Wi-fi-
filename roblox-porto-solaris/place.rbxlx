		ContlrPBrake			= Enum.KeyCode.ButtonL1				,
		ContlrToggleTMode		= Enum.KeyCode.DPadUp				,
		ContlrToggleTCS			= Enum.KeyCode.DPadDown				,
		ContlrToggleABS			= Enum.KeyCode.DPadRight			,
	}
	
return Tune]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBXV00000000000000000000000000008C"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Plugins</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Frame" referent="RBXV00000000000000000000000000008D"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0.0</X><Y>0.0</Y></Vector2><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><float name="BackgroundTransparency">1.0</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">0</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><string name="Name">AC6_Controls_Module</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><UDim2 name="Position"><XS>0.0</XS><XO>0</XO><YS>0.0</YS><YO>0</YO></UDim2><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0.0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><UDim2 name="Size"><XS>1.0</XS><XO>0</XO><YS>1.0</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><token name="Style">0</token><bool name="Visible">true</bool><int name="ZIndex">3</int></Properties><Item class="LocalScript" referent="RBXV00000000000000000000000000008E"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Controls_AC6</string><token name="RunContext">0</token><string name="ScriptGuid">{802D9F70-6434-4A77-A3A3-33030119C780}</string><ProtectedString name="Source"><![CDATA[--[[
