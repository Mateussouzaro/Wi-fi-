00000000003CE"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Handler</string><token name="RunContext">0</token><string name="ScriptGuid">{F581217A-186A-4C7A-A2F7-8942832B4B74}</string><ProtectedString name="Source"><![CDATA[--[[

   ____ ___   ____ _____ __    ____ _____ __ __ ______ ____  _   __ ____
  / __// _ \ /  _// ___// /   /  _// ___// // //_  __// __/ | | / // / /
