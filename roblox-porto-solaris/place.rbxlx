0000000000313"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Handler</string><token name="RunContext">0</token><string name="ScriptGuid">{C6493CC1-DCDB-4DBF-82B4-58E95F8D6314}</string><ProtectedString name="Source"><![CDATA[--[[

