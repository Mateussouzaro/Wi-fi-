er"><min><X>0.0</X><Y>0.0</Y></min><max><X>0.0</X><Y>0.0</Y></max></Rect2D><float name="SliceScale">1.0</float><int64 name="SourceAssetId">-1</int64><token name="Style">0</token><UDim2 name="TileSize"><XS>1.0</XS><XO>0</XO><YS>1.0</YS><YO>0</YO></UDim2><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties></Item></Item></Item><Item class="LocalScript" referent="RBXV0100000000000000000000000002F6"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">GUI</string><token name="RunContext">0</token><string name="ScriptGuid">{DD5CEF2D-6E76-47DA-8A6C-AC48EC59D900}</string><ProtectedString name="Source"><![CDATA[local car = script.Parent.Fob.Value.CarModel.Value
local main = script.Parent.KeyfobGUI
local spgui = script.Parent.SmartParkGUI

local lights = car:WaitForChild("Lights")
local handler = car.DriveSeat:WaitForChild("Filter")

local Alarm = false

function alarm()
	while Alarm do
		lights:FireServer('alarm')
		wait(1.3)
	end
end

function Warning(text)
	script.Parent.Warning.Visible = true
	script.Parent.Warning.Text = text
	wait(3)
	script.Parent.Warning.Visible = false
	script.Parent.Warning.Text = ""
end

function SmartPark(motion)
	if motion == "forward" then
		for i,v in pairs(car.Wheels:GetDescendants()) do
			if v.Name == "#AV" then
				v.AngularVelocity = 3
				v.MotorMaxTorque = 100
			elseif v.Name == "#BV" then
				v.AngularVelocity = 0
				v.MotorMaxTorque = 0
			end
		end
		lights:FireServer('Lights', 'brake', false)
		lights:FireServer('Lights', 'reverse', false)
	elseif motion == "brake" then
		for i,v in pairs(car.Wheels:GetDescendants()) do
			if v.Name == "#AV" then
				v.AngularVelocity = 0
				v.MotorMaxTorque = 0
			elseif v.Name == "#BV" then
				v.AngularVelocity = 0
				v.MotorMaxTorque = 500
			end
		end
		lights:FireServer('Lights', 'brake', true)
		lights:FireServer('Lights', 'reverse', false)
	elseif motion == "reverse" then
		for i,v in pairs(car.Wheels:GetDescendants()) do
			if v.Name == "#AV" then
				v.AngularVelocity = -3
				v.MotorMaxTorque = 100
			elseif v.Name == "#BV" then
				v.AngularVelocity = 0
				v.MotorMaxTorque = 0
			end
		end
		lights:FireServer('Lights', 'brake', true)
		lights:FireServer('Lights', 'reverse', true)
	elseif motion == "idle" then
		for i,v in pairs(car.Wheels:GetDescendants()) do
			if v.Name == "#AV" then
				v.AngularVelocity = 0
				v.MotorMaxTorque = 0
			elseif v.Name == "#BV" then
				v.AngularVelocity = 0
				v.MotorMaxTorque = 0
			end
		end
		lights:FireServer('Lights', 'brake', false)
		lights:FireServer('Lights', 'reverse', false)
	end
end

main.Buttons.Trunk.MouseButton1Down:Connect(function()
	if car.DriveSeat.IsOn.Value == false then
		if car.Misc.Doors.Trunk.SS.Motor.DesiredAngle == 0 then
			handler:FireServer("trunk", true)
		else
			handler:FireServer("trunk", false)
		end
	else
		Warning("This function cannot be used when the ignition is on.")
	end
end)

main.Buttons.Lock.MouseButton1Down:Connect(function()
	Alarm = false
	if car.DriveSeat.IsOn.Value == false then
		handler:FireServer("Security", "Lock")
		lights:FireServer('flash')
	else
		Warning("This function cannot be used when the ignition is on.")
	end
end)

unlockhold = false

main.Buttons.Unlock.MouseButton1Down:Connect(function()
	unlockhold = true
	Alarm = false
	if car.DriveSeat.IsOn.Value == false then
		handler:FireServer("Security", "Unlock")
		lights:FireServer('flash')
	else
		Warning("This function cannot be used when the ignition is on.")
	end
	wait(3)
	if unlockhold == true then
		handler:FireServer('UpdateWindows', 'LD')
		handler:FireServer('UpdateWindows', 'RD')
	end
end)
main.Buttons.Unlock.MouseButton1Up:Connect(function()
	unlockhold = false
end)

alarmhold = false

main.Buttons.Alarm.MouseButton1Down:Connect(function()
	alarmhold = true
	wait(3)
	if alarmhold == true then
		if Alarm == false then
			Alarm = true
			alarm()
		end
	end
end)
main.Buttons.Alarm.MouseButton1Up:Connect(function()
	alarmhold = false
end)

spgui.Ignition.MouseButton1Down:Connect(function()
	handler:FireServer("Start")
end)

holding = false

spgui.Buttons.Forward.MouseButton1Down:Connect(function()
	if car.DriveSeat.IsOn.Value == true then
		holding = true
		SmartPark("idle")
		SmartPark("forward")
	else
		Warning("This function can only be used when the ignition is on.")
	end
end)
spgui.Buttons.Reverse.MouseButton1Down:Connect(function()
	if car.DriveSeat.IsOn.Value == true then
		holding = true
		SmartPark("idle")
		SmartPark("reverse")
	else
		Warning("This function can only be used when the ignition is on.")
	end
end)
spgui.Buttons.Forward.MouseButton1Up:Connect(function()
	if car.DriveSeat.IsOn.Value == true then
		holding = false
		SmartPark("brake")
		wait(3)
		if holding == false then
			SmartPark("idle")
		end
	end
end)
spgui.Buttons.Reverse.MouseButton1Up:Connect(function()
	if car.DriveSeat.IsOn.Value == true then
		holding = false
		SmartPark("brake")
		wait(3)
		if holding == false then
			SmartPark("idle")
		end
	end
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="TextLabel" referent="RBXV0100000000000000000000000002F7"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.0</Y></Vector2><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><float name="BackgroundTransparency">1.0</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">1</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/RobotoMono.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><float name="LineHeight">1.0</float><string name="LocalizationMatchIdentifier"></string><string name="LocalizationMatchedSourceText"></string><int name="MaxVisibleGraphemes">-1</int><string name="Name">Warning</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><string name="OpenTypeFeatures"></string><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.8181437253952026</YS><YO>0</YO></UDim2><bool name="RichText">false</bool><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0.0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><UDim2 name="Size"><XS>0.45475515723228455</XS><XO>0</XO><YS>0.04674660786986351</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><string name="Text">This function cannot be used when the ignition is on.</string><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><token name="TextDirection">0</token><bool name="TextScaled">true</bool><float name="TextSize">14.0</float><Color3 name="TextStrokeColor3"><R>0.0</R><G>0.0</G><B>0.0</B></Color3><float name="TextStrokeTransparency">1.0</float><float name="TextTransparency">0.0</float><token name="TextTruncate">0</token><bool name="TextWrapped">true</bool><token name="TextXAlignment">2</token><token name="TextYAlignment">1</token><bool name="Visible">false</bool><int name="ZIndex">1</int></Properties></Item></Item><Item class="LocalScript" referent="RBXV0100000000000000000000000002F8"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Spawner</string><token name="RunContext">0</token><string name="ScriptGuid">{CD05FA01-C694-4C67-BA26-3E2483DCAA99}</string><ProtectedString name="Source"><![CDATA[local Tool = script.Parent
local vPlayer
local Gui
local Text

local car = script.Parent.CarModel.Value

function setUpGui()
	if vPlayer == nil or vPlayer:findFirstChild("PlayerGui") == nil then
		return
	end
	Gui = script.Parent.Keyscreen:Clone()
	Gui.Parent = vPlayer.PlayerGui
end

function onEquippedLocal(mouse)
	vPlayer = game.Players.LocalPlayer

	setUpGui()
end

function onUnequippedLocal(mouse)
	if Gui then
		Gui:remove()
	end

	Gui = nil
	Text = nil
	vPlayer = nil
end

Tool.Equipped:connect(onEquippedLocal)

Tool.Unequipped:connect(onUnequippedLocal)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBXV0100000000000000000000000002F9"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Stations</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV0100000000000000000000000002FA"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Set</string><token name="RunContext">0</token><string name="ScriptGuid">{D85B3484-B3E0-4C1D-8F7F-3A263C326104}</string><ProtectedString name="Source"><![CDATA[script.Parent.mood.Changed:connect(function()
