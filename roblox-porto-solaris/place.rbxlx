><Content name="SoundId"><url>rbxassetid://10617066684</url></Content><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0.0</double><float name="Volume">1.0</float><float name="xmlRead_MaxDistance_3">10000.0</float></Properties></Item><Item class="ClickDetector" referent="RBXV03000000000000000000000000026A"><Properties><string name="CursorIcon"></string><bool name="DefinesCapabilities">false</bool><float name="MaxActivationDistance">12.0</float><string name="Name">ClickDetector</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV03000000000000000000000000026B"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Script</string><token name="RunContext">0</token><string name="ScriptGuid">{B7408621-3E86-40AC-90DF-63CE4279C7F2}</string><ProtectedString name="Source"><![CDATA[wait(0.1)
local m = script.Parent.Parent.Parent.SS.Motor

script.Parent.MouseClick:connect(function(p)
if m.DesiredAngle == 0 then
	m.DesiredAngle = -1
	script.Parent.Parent.DoorOpen:Play()
elseif m.DesiredAngle == -1 then
	m.DesiredAngle = 0
	while m.CurrentAngle < 0 do wait() end
