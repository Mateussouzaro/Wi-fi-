me">Left</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV0500000000000000000000000000BB"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">RunningLights</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV0500000000000000000000000000BC"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Right</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="NumberValue" referent="RBXV0500000000000000000000000000BD"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Headlights</string><int64 name="SourceAssetId">-1</int64><double name="Value">0.0</double></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBXV0500000000000000000000000000BE"><Properties><bool name="DefinesCapabilities">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Configuration</string><string name="ScriptGuid">{FF51B027-4F20-4796-923F-B89D567C9A13}</string><ProtectedString name="Source"><![CDATA[--[[

