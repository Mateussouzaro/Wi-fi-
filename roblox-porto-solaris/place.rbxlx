-- ------------------------------------------------------------------ places to discover (credits)
local PLACES = {
	{ id = "meet", name = "Encontro Solaris", pos = V(105, 0, 0), r = 75 },
	{ id = "posto", name = "Posto Aurora", pos = V(260, 0, -60), r = 35 },
	{ id = "loja", name = "Solaris Motors", pos = V(-180, 0, -60), r = 35 },
	{ id = "centro", name = "Centro", pos = V(0, 0, -390), r = 90 },
	{ id = "praia", name = "Mirante do Píer", pos = V(0, 0, 500), r = 25 },
}
local placesValue = Instance.new("StringValue")
placesValue.Name = "Lugares"
do
	local t = {}
	for _, p in ipairs(PLACES) do table.insert(t, p.id .. "|" .. p.name .. "|" .. p.pos.X .. "|" .. p.pos.Z) end
	placesValue.Value = table.concat(t, ";")
end
placesValue.Parent = ReplicatedStorage

-- ------------------------------------------------------------------ players: credits, owned cars, tutorial, discovered places
local data = {}
local function save(plr)
	local d = data[plr]
	if not d or not store then return end
	pcall(function() store:SetAsync("p_" .. plr.UserId, d) end)
end
local function sendProgress(plr)
	local d = data[plr]
	if d then Progress:FireClient(plr, d) end
end
local function addCredits(plr, n, why)
	local d = data[plr]
	if not d then return end
	d.credits = d.credits + n
	local ls = plr:FindFirstChild("leaderstats")
	if ls then ls.Creditos.Value = d.credits end
	Notify:FireClient(plr, "credits", n, why)
	sendProgress(plr)
	save(plr)
end

Players.PlayerAdded:Connect(function(plr)
	local d = { credits = 0, owned = {}, tutorial = false, found = {} }
	if store then
		local ok, s = pcall(function() return store:GetAsync("p_" .. plr.UserId) end)
		if ok and type(s) == "table" then
			d.credits = s.credits or 0
			d.owned = s.owned or {}
			d.tutorial = s.tutorial or false
			d.found = s.found or {}
		end
	end
	data[plr] = d
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local c = Instance.new("IntValue")
	c.Name = "Creditos"
	c.Value = d.credits
	c.Parent = ls
	ls.Parent = plr
	task.wait(1)
	sendProgress(plr)
end)
Players.PlayerRemoving:Connect(function(plr)
	save(plr)
	local car = carsFolder:FindFirstChild("Carro_" .. plr.UserId)
	if car then car:Destroy() end
	data[plr] = nil
end)

-- spawn the chosen car next to the player and sit them in it
SpawnCar.OnServerEvent:Connect(function(plr, id, colorIndex, liveryIndex)
	local d = data[plr]
	local spec = CAR_BY_ID[id]
	if not d or not spec then return end
	if spec.price > 0 and not d.owned[id] then
		if d.credits < spec.price then
			Notify:FireClient(plr, "nomoney", spec.price - d.credits)
			return
		end
		d.credits = d.credits - spec.price
		d.owned[id] = true
		local ls = plr:FindFirstChild("leaderstats")
		if ls then ls.Creditos.Value = d.credits end
		Notify:FireClient(plr, "bought", spec.name)
		save(plr)
	end
	local char = plr.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return end
	local old = carsFolder:FindFirstChild("Carro_" .. plr.UserId)
	if old then old:Destroy() end
	local color = PALETTE[tonumber(colorIndex) or 1] or PALETTE[1]
	local livery = nil
	local li = tonumber(liveryIndex) or 0
	if li > 0 then livery = PALETTE[li] end
	local look = root.CFrame.LookVector
	look = V(look.X, 0, look.Z).Unit
	local pos = root.Position + look * 12
	local cf = CFrame.lookAt(V(pos.X, 0.5, pos.Z), V(pos.X, 0.5, pos.Z) + look)
	local car = buildCar(spec, color, cf, true, livery)
	car.Name = "Carro_" .. plr.UserId
	car:SetAttribute("Owner", plr.UserId)
	task.wait(0.2)
	local seat = car:FindFirstChild("Banco")
	if seat and hum then seat:Sit(hum) end
	sendProgress(plr)
end)

Progress.OnServerEvent:Connect(function(plr, kind, value)
	local d = data[plr]
	if not d then return end
	if kind == "tutorial" and not d.tutorial then
		d.tutorial = true
		addCredits(plr, 500, "Tutorial concluído")
	elseif kind == "found" and type(value) == "string" and not d.found[value] then
		for _, p in ipairs(PLACES) do
			if p.id == value then
				local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
				if root and (V(root.Position.X, 0, root.Position.Z) - p.pos).Magnitude < p.r + 20 then
					d.found[value] = true
					addCredits(plr, 100, "Novo lugar: " .. p.name)
				end
			end
		end
	end
end)

-- ------------------------------------------------------------------ day/night cycle and animations
local DAY_LENGTH = 16 * 60 -- seconds for a full day
local last = os.clock()
RunService.Heartbeat:Connect(function(dt)
	Lighting.ClockTime = (Lighting.ClockTime + dt * 24 / DAY_LENGTH) % 24
	for _, t in ipairs(turntables) do
		t.base = t.base * CFrame.Angles(0, t.speed * dt, 0)
		t.car:PivotTo(t.base)
	end
end)
task.spawn(function()
	local wasNight = nil
	while true do
		local ct = Lighting.ClockTime
		local night = ct > 18.2 or ct < 6.2
		if night ~= wasNight then
			wasNight = night
			for _, n in ipairs(nightLights) do
				if n.l then n.l.Enabled = night end
				if n.band then n.band.Material = night and Enum.Material.Neon or Enum.Material.SmoothPlastic n.band.Transparency = night and 0.2 or 0.7 end
			end
			-- spawned cars switch headlights too
			for _, car in ipairs(carsFolder:GetChildren()) do
				for _, d in ipairs(car:GetDescendants()) do
					if d:IsA("SpotLight") then d.Enabled = night end
				end
			end
			atmo.Density = night and 0.38 or 0.3
		end
		task.wait(2)
		local _ = last
	end
end)
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">Jogador</string><bool name="Disabled">false</bool><ProtectedString name="Source"><![CDATA[-- Porto Solaris — client: cinematic intro, tutorial, garage, driving, speedometer,
-- poses, photo mode, places to discover and notifications.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local SpawnCar = ReplicatedStorage:WaitForChild("SpawnCar")
local Notify = ReplicatedStorage:WaitForChild("Notify")
local Progress = ReplicatedStorage:WaitForChild("Progress")
local catalogueValue = ReplicatedStorage:WaitForChild("Catalogo")
local placesValue = ReplicatedStorage:WaitForChild("Lugares")

local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end
local GOLD = rgb(255, 200, 60)
local DARK = rgb(14, 15, 18)

-- ------------------------------------------------------------------ sounds (built into the client)
local function snd(id, vol)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume = vol
	s.Parent = SoundService
	return s
end
local sClick = snd("rbxasset://sounds/electronicpingshort.wav", 0.35)
local sDone = snd("rbxasset://sounds/button.wav", 0.7)
local sWhoosh = snd("rbxasset://sounds/action_falling.mp3", 0.25)

-- ------------------------------------------------------------------ data from the server
local CARS = {}
for entry in string.gmatch(catalogueValue.Value, "[^;]+") do
	local id, name, price, top, acc, tag = string.match(entry, "([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)|([^|]+)")
	table.insert(CARS, { id = id, name = name, price = tonumber(price), top = tonumber(top), acc = tonumber(acc), tag = tag })
end
local PLACES = {}
for entry in string.gmatch(placesValue.Value, "[^;]+") do
	local id, name, x, z = string.match(entry, "([^|]+)|([^|]+)|([^|]+)|([^|]+)")
	table.insert(PLACES, { id = id, name = name, pos = Vector3.new(tonumber(x), 0, tonumber(z)) })
end
local progress = { credits = 0, owned = {}, tutorial = false, found = {} }

-- ------------------------------------------------------------------ UI helpers
local gui = Instance.new("ScreenGui")
gui.Name = "PortoSolaris"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(o, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or 12)
	c.Parent = o
end
local function stroke(o, col, th, tr)
	local s = Instance.new("UIStroke")
	s.Color = col
	s.Thickness = th or 2
	s.Transparency = tr or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = o
end
local function frame(parent, size, pos, color, tr)
	local f = Instance.new("Frame")
	f.Size = size
	f.Position = pos
	f.BackgroundColor3 = color or DARK
	f.BackgroundTransparency = tr or 0.15
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end
local function text(parent, t, size, pos, font, ts, color)
	local l = Instance.new("TextLabel")
	l.Size = size
	l.Position = pos
	l.BackgroundTransparency = 1
	l.Text = t
	l.Font = font or Enum.Font.GothamBold
	l.TextSize = ts or 16
	l.TextColor3 = color or Color3.new(1, 1, 1)
	l.TextWrapped = true
	l.Parent = parent
	return l
end
local function button(parent, t, size, pos, color)
	local b = Instance.new("TextButton")
	b.Size = size
	b.Position = pos
	b.BackgroundColor3 = color or rgb(30, 32, 38)
	b.BackgroundTransparency = 0.05
	b.Text = t
	b.Font = Enum.Font.GothamBlack
	b.TextSize = 16
	b.TextColor3 = Color3.new(1, 1, 1)
	b.AutoButtonColor = true
	b.Parent = parent
	corner(b, 12)
	b.MouseButton1Down:Connect(function()
		sClick:Play()
		local s0 = b.Size
		b.Size = UDim2.new(s0.X.Scale * 0.94, s0.X.Offset * 0.94, s0.Y.Scale * 0.94, s0.Y.Offset * 0.94)
		task.delay(0.08, function() b.Size = s0 end)
	end)
	return b
end
local function slideIn(f, from)
	local goal = f.Position
	f.Position = from
	f.Visible = true
	TweenService:Create(f, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = goal }):Play()
end

-- ------------------------------------------------------------------ toast notifications
local toastHolder = frame(gui, UDim2.new(0, 320, 0, 300), UDim2.new(0.5, -160, 0, 70), DARK, 1)
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Parent = toastHolder
local function toast(msg, color)
	local t = frame(toastHolder, UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, 0), DARK, 0.1)
	corner(t, 20)
	stroke(t, color or GOLD, 2)
	local l = text(t, msg, UDim2.new(1, -20, 1, 0), UDim2.new(0, 10, 0, 0), Enum.Font.GothamBold, 15, color or GOLD)
	l.TextTransparency = 1
	TweenService:Create(l, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()
	task.delay(3.5, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		TweenService:Create(t, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
		task.wait(0.45)
		t:Destroy()
	end)
end

