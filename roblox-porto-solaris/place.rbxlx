local _SteerR = false
local _PBrake = false
local _TCSActive = false
local _TCSAmt = 0
local _ABSActive = false

F.Update = function()
	car["A-Chassis Tune"]["A-Chassis Interface"].Values.Gear.Value = _CGear
	car["A-Chassis Tune"]["A-Chassis Interface"].Values.Throttle.Value = _GThrot
	car["A-Chassis Tune"]["A-Chassis Interface"].Values.Brake.Value = _GBrake
	car["A-Chassis Tune"]["A-Chassis Interface"].Values.RPM.Value = _RPM
	car["A-Chassis Tune"]["A-Chassis Interface"].Values.SteerC.Value = _GSteerC
	car["A-Chassis Tune"]["A-Chassis Interface"].Values.SteerT.Value = _GSteerT
	car["A-Chassis Tune"]["A-Chassis Interface"].Values.PBrake.Value = _PBrake
end

