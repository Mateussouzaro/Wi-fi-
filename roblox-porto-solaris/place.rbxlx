oken name="RunContext">0</token><string name="ScriptGuid">{23F2929B-6D59-4BED-93A6-CDE5368E42AA}</string><ProtectedString name="Source"><![CDATA[--Make sure SmokePart is in WheelFixed model (NOT Fixed).
--The arrow on SmokePart has to point towards the front of your car.
--SmokePart has to be in all four wheels.
--SmokePart has to lay flat with the bottom of your tire.
--(Not too low or tiremarks will clip through the ground)


--Remove Advanced_Smoke_v1.1 script from SmokePart and put it in Plugins folder


--Image preview of proper installation moved onto a decal "Install_Guide" (to avoid potential offsite links)

--v1.1 update: animated smoke particles ("flipbook")]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="Decal" referent="RBXV040000000000000000000000000095"><Properties><Color3 name="Color3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><bool name="DefinesCapabilities">false</bool><token name="Face">1</token><string name="Name">Install_Guide</string><int64 name="SourceAssetId">10007480314</int64><Content name="Texture"><url>http://www.roblox.com/asset/?id=10007480270</url></Content><float name="Transparency">0.0</float><int name="ZIndex">1</int></Properties></Item></Item></Item></Item><Item class="Model" referent="RBXV040000000000000000000000000096"><Properties><bool name="DefinesCapabilities">false</bool><token name="LevelOfDetail">0</token><CoordinateFrame name="ModelMeshCFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="ModelMeshSize"><X>0.0</X><Y>0.0</Y><Z>0.0</Z></Vector3><token name="ModelStreamingMode">0</token><string name="Name">SuspensionFixed</string><bool name="NeedsPivotMigration">false</bool><Ref name="PrimaryPart">null</Ref><float name="ScaleFactor">1.0</float><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="CylinderMesh" referent="RBXV040000000000000000000000000097"><Properties><float name="Bevel">0.0</float><float name="Bevel Roundness">0.0</float><float name="Bulge">0.0</float><bool name="DefinesCapabilities">false</bool><string name="Name">Mesh</string><Vector3 name="Offset"><X>0.0</X><Y>0.0</Y><Z>0.0</Z></Vector3><Vector3 name="Scale"><X>1.0</X><Y>0.5</Y><Z>1.0</Z></Vector3><int64 name="SourceAssetId">-1</int64><Vector3 name="VertexColor"><X>1.0</X><Y>1.0</Y><Z>1.0</Z></Vector3></Properties></Item><Item class="Model" referent="RBXV040000000000000000000000000098"><Properties><bool name="DefinesCapabilities">false</bool><token name="LevelOfDetail">0</token><CoordinateFrame na