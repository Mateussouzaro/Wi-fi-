urceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV1000000000000000000000000003E0"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">RunningLights</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV1000000000000000000000000003E1"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Right</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="NumberValue" referent="RBXV1000000000000000000000000003E2"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Headlights</string><int64 name="SourceAssetId">-1</int64><double name="Value">0.0</double></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBXV1000000000000000000000000003E3"><Properties><bool name="DefinesCapabilities">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Configuration</string><string name="ScriptGuid">{8EEE18EC-1705-4CCB-9583-1B78D5F1EE1A}</string><ProtectedString name="Source"><![CDATA[--[[

