el" referent="RBXV0200000000000000000000000000E6"><Properties><bool name="DefinesCapabilities">false</bool><token name="LevelOfDetail">0</token><CoordinateFrame name="ModelMeshCFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="ModelMeshSize"><X>0.0</X><Y>0.0</Y><Z>0.0</Z></Vector3><token name="ModelStreamingMode">0</token><string name="Name">Plate</string><bool name="NeedsPivotMigration">false</bool><Ref name="PrimaryPart">null</Ref><float name="ScaleFactor">1.0</float><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV0200000000000000000000000000E7"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">LicensePlateGenerator</string><token name="RunContext">0</token><string name="ScriptGuid">{1BF7252A-BDB1-4B88-BFC6-7C5DA22B1CDB}</string><ProtectedString name="Source"><![CDATA[local pattern = "000"
local plate = ""

for i = 1, #pattern do
	local c = string.sub(pattern, i, i)
	if (c == "0") then
		plate = plate..tostring(math.random(71,91))
	elseif (c == "X") then
		plate = plate..string.char(math.random(65,90))
	else
		plate = plate..c
	end
end

for i,v in pairs(script.Parent.Plates:GetChildren()) do
	v.SGUI.Identifier.Text = plate
end
script:Destroy()]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="Model" referent="RBXV0200000000000000000000000000E8"><Properties><bool name="DefinesCapabilities">false</bool><token name="LevelOfDetail">0</token><CoordinateFrame name="ModelMeshCFrame"><X>0.0</X><Y>0.0</Y><Z>0.0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Vector3 name="ModelMeshSize"><X>0.0</X><Y>0.0</Y><Z>0.0</Z></Vector3><token name="ModelStreamingMode">0</token><string name="Name">Plates</string><bool name="NeedsPivotMigration">false</bool><Ref name="PrimaryPart">null</Ref><float name="ScaleFactor">1.0</float><int64 name="SourceAssetId">-1</int64></Properties><Item class="Part" referent="RBXV0200000000000000000000000000E9"><Properties><bool name="Anchored">true</bool><float name="BackParamA">-0.5</float><float name="BackParamB">0.5</float><token name="BackSurface">10</token><token name="BackSurfaceInput">0</token><float name="BottomParamA">-0.5</float><float name="BottomParamB">0.5</float><token name="BottomSurface">10</token><token name="BottomSurfaceInput">0</token><CoordinateFrame name="CFrame"><X>-77.52278137207031</X><Y>2.1252338886260986</Y><Z>-11.216537475585938</Z><R00>0.9999996423721313</R00><R01>-0.0007265593158081174</R01><R02>-0.0004945392138324678</R02><R10>0.0007970315054990351</R10><R11>0.9868105053901672</R11><R12>0.16187767684459686</R12><R20>0.0003704027330968529</R20><R21>-0.16187800467014313</R21><R22>0.9868107438087463</R22></CoordinateFrame><bool name="CanCollide">false</bool><bool name="CanQuery">true</bool><bool name="CanTouch">true</bool><bool name="CastShadow">true</bool><string name="CollisionGroup">Default</string><int name="CollisionGroupId">0</int><Color3uint8 name="Color3uint8">4294506744</Color3uint8><PhysicalProperties name="CustomPhysicalProperties"><CustomPhysics>true</CustomPhysics><Density>0.009999999776482582</Density><Friction>0.200