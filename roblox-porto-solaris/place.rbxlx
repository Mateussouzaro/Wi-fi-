			ns.RollOffMaxDistance=info[8]
			ns.RollOffMinDistance=info[9]
			ns.Looped=false
		end
		ns:Play()
		table.insert(newsounds,k,ns)
	end
end

local function update(sounds,info)
	if newsounds[1].Volume~=info[1] then 
		newsounds[1].Volume=info[1]
		newsounds[1].Pitch=info[2]
		newsounds[2].Volume=info[3]
		newsounds[2].Pitch=info[4]
		newsounds[3].Volume=info[5]
		newsounds[3].Pitch=info[6]
	end
end

script.Parent.OnServerEvent:Connect(function(plr,car,func,...)
	if func=='create' then
		if #newsounds<1 then create(car,...) end
		
	elseif func=='update' then
		update(...)
	elseif func=='stop' then
		for _,s in pairs(newsounds) do s:Stop() end
	elseif func=='play' then
		for _,s in pairs(newsounds) do s:Play() end
	elseif func=='bovplay' then
		newsounds[3]:Play()
	end
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item></Item><Item class="ImageLabel" referent="RBXV110000000000000000000000000359"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0.0</X><Y>1.0</Y></Vector2><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><float name="BackgroundTransparency">1.0</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">0</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Content name="Image"><null></null></Content><Color3 name="ImageColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><Vector2 name="ImageRectOffset"><X>0.0</X><Y>0.0</Y></Vector2><Vector2 name="ImageRectSize"><X>0.0</X><Y>0.0</Y></Vector2><float name="ImageTransparency">1.0</float><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><string name="Name">RTRA Tire System</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><UDim2 name="Position"><XS>0.04500000178813934</XS><XO>0</XO><YS>0.8700000047683716</YS><YO>0</YO></UDim2><token name="ResampleMode">0</token><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0.0</float><token name="ScaleType">0</token><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><UDim2 name="Size"><XS>0.3499999940395355</XS><XO>0</XO><YS>0.3499999940395355</YS><YO>0</YO></UDi