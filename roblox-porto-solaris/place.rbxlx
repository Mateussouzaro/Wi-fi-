			sign(part({ Size = V(30, 4, 0.4), CFrame = CFrame.new(wx, 17, wz + 25.3), Color = rgb(20, 20, 24), Material = Enum.Material.SmoothPlastic }), "GALPÃO " .. (i + 1), rgb(255, 210, 60))
