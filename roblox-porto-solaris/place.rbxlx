tance_3">100.0</float></Properties><Item class="Script" referent="RBXV01000000000000000000000000021C"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Control</string><token name="RunContext">0</token><string name="ScriptGuid">{DDCB4C8A-9A33-46AE-83DB-0359A908B6DE}</string><ProtectedString name="Source"><![CDATA[if script.Parent.Parent:IsA("VehicleSeat") then
	script.Parent.Parent.ChildAdded:connect(function(child)
		if child.Name == "SeatWeld" and game.Players:GetPlayerFromCharacter(child.Part1.Parent)~=nil then
			local p=game.Players:GetPlayerFromCharacter(child.Part1.Parent)
			local g=script.G:Clone()
			g.Parent=p.PlayerGui
			g:WaitForChild("src")
			g.src.Value=script.Parent
			g.Horn.Disabled=false		
		end
	end)
end]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="ScreenGui" referent="RBXV01000000000000000000000000021D"><Properties><bool name="AutoLocalize">true</bool><bool name="ClipToDeviceSafeArea">true</bool><bool name="DefinesCapabilities">false</bool><int name="DisplayOrder">0</int><bool name="Enabled">true</bool><string name="Name">G</string><bool name="ResetOnSpawn">true</bool><Ref name="RootLocalizationTable">null</Ref><token name="SafeAreaCompatibility">1</token><token name="ScreenInsets">2</token><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><int64 name="SourceAssetId">-1</int64><token name="ZIndexBehavior">0</token></Properties><Item class="LocalScript" referent="RBXV01000000000000000000000000021E"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Horn</string><token name="RunContext">0</token><string name="ScriptGuid">{DC0CC226-07CE-406C-99DB-C50CBDD651FE}</string><ProtectedString name="Source"><![CDATA[local mouse=game.Players.LocalPlayer:GetMouse()
script.Parent:WaitForChild("src")
src=script.Parent.src.Value
mouse.KeyDown:connect(function(key)
	if key=="h" then 
		src:Play()
	end
end)
mouse.KeyUp:connect(function(key)
	if key=="h" then 
		src:Stop()
	end
end)
src.Parent.ChildRemoved:connect(function(child)
	if child.Name=="SeatWeld" then 
		src:Stop()
		script.Parent:Destroy()
	end
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ObjectValue" referent="RBXV01000000000000000000000000021F"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">src</string><int64 name="SourceAssetId">-1</int64><Ref name="Value">null</Ref></Properties></Item></Item></Item></Item><Item class="Sound" referent="RBXV010000000000000000000000000220"><Properties><bool name="DefinesCapabilities">false</bool><float name="EmitterSize">10.0</float><NumberRange name="LoopRegion">0.0 60000.0 </NumberRange><bool name="Looped">false</bool><string name="Name">LockChime</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0.0 60000.0 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1.0</float><bool name="Playing">false</bool><token name="RollOffMode">0</token><Ref name="SoundGroup">null</Ref><Content name="SoundId"><url>rbxassetid://6281526004</url></Content><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0.0</double><float name="Volume">0.6499999761581421</float><float name="xmlRead_MaxDistance_3">10000.0</float></Properties></Item><Item class="Sound" referent="RBXV010000000000000000000000000221"><Properties><bool name="DefinesCapabilities">false</bool><float name="EmitterSize">10.0</float><NumberRange name="LoopRegion">0.0 60000.0 </NumberRange><bool name="Looped">true</bool><string name="Name">Rev</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0.0 60000.0 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">0.3310000002384186</float><bool name="Playing">false</bool><token name="RollOffMode">0</token><Ref name="SoundGroup">null</Ref><Content name="SoundId"><url>rbxassetid://842506094</url></Content><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0.0</double><float name="Volume">0.6000000238418579</float><float name="xmlRead_MaxDistance_3"