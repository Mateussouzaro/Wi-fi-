ies></Item><Item class="LocalScript" referent="RBXV0100000000000000000000000002E1"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">UIScript</string><token name="RunContext">0</token><string name="ScriptGuid">{69887202-01F6-40BA-AE69-5B837884D590}</string><ProtectedString name="Source"><![CDATA[--[[
