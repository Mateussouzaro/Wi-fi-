urceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV070000000000000000000000000303"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">RunningLights</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV070000000000000000000000000304"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Right</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="NumberValue" referent="RBXV070000000000000000000000000305"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Headlights</string><int64 name="SourceAssetId">-1</int64><double name="Value">0.0</double></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBXV070000000000000000000000000306"><Properties><bool name="DefinesCapabilities">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Configuration</string><string name="ScriptGuid">{C385EDAE-DDC2-40EC-8AC6-8320C61814F9}</string><ProtectedString name="Source"><![CDATA[--[[

