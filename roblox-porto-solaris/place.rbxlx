-- EDITED BY BOBNOOBINGTON
-- CLICK THE GUI TO TOGGLE BETWEEN HORSEPOWER/TORQUE READINGS

local car = script.Parent.Parent.Car.Value
local player=game.Players.LocalPlayer
local mouse = player:GetMouse()
local MaxHP = 0
local MaxTQ = 0

script.Parent:WaitForChild("Button")

script.Parent.Button.MouseButton1Click:connect(function()
	   script.Parent.HP.Visible = not script.Parent.HP.Visible
	   script.Parent.MAXHP.Visible = not script.Parent.MAXHP.Visible
	   script.Parent.TQ.Visible = not script.Parent.TQ.Visible
	   script.Parent.MAXTQ.Visible = not script.Parent.MAXTQ.Visible
end)

while wait() do
	if math.floor(script.Parent.Parent.Values.Horsepower.Value) > MaxHP then
		MaxHP = math.floor(script.Parent.Parent.Values.Horsepower.Value)
	end
	script.Parent.HP.Text ="HP: ".. math.floor(script.Parent.Parent.Values.Horsepower.Value)
	script.Parent.MAXHP.Text = "MaxHP: " .. MaxHP
	
	if math.floor(script.Parent.Parent.Values.Torque.Value) > MaxTQ then
		MaxTQ = math.floor(script.Parent.Parent.Values.Torque.Value)
	end
	script.Parent.TQ.Text ="TQ: ".. math.floor(script.Parent.Parent.Values.Torque.Value)
	script.Parent.MAXTQ.Text = "MaxTQ: " .. MaxTQ
end]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="LocalScript" referent="RBXV0700000000000000000000000002E1"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Aerodynamics</string><token name="RunContext">0</token><string name="ScriptGuid">{555020FB-62F6-4F8C-9A8E-E1C3B27E33EC}</string><ProtectedString name="Source"><![CDATA[--Editable Values
local Drag = .34  	--Drag Coefficient
local F = 125		--Downforce at 300 SPS
local R = 150		--Downforce at 300 SPS
local Vol = 1 		
--End of Editable Values

local car = script.Parent.Car.Value
local hb = game:GetService('RunService').Heartbeat
local sound = car.Body.Drag.Wind
local sound2 = car.Body.Drag.Body
sound:Play()
sound2:Play()

local function update()
	sound.Volume=Vol*(car.DriveSeat.Velocity.Magnitude/500)
	sound2.Volume=Vol*(car.DriveSeat.Velocity.Magnitude/500)
	car.Body.DownforceF.T.Force = Vector3.new(0,(car.DriveSeat.Velocity.Magnitude/-300)*F,0)
	car.Body.DownforceR.T.Force = Vector3.new(0,(car.DriveSeat.Velocity.Magnitude/-300)*R,0)
	car.Body.Drag.T.Force = Vector3.new(0,0,(car.DriveSeat.Velocity.magnitude^2*(Drag/30)))
end

hb:Connect(update)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="Frame" referent="RBXV0700000000000000000000000002E2"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0.0</X><Y>0.0</Y></Vector2><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><float name="BackgroundTransparency">1.0</float><Color3 name="BorderColor3"><R>0.10588236153125763</R><G>0.16470588743686676</G><B>0.20784315466880798</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">1</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><string name="Name">EPICLIGHTS_V4</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><UDim2 name="Position"><XS>0.0</XS><XO>0</XO><YS>0.0</YS><YO>0</YO></UDim2><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0.0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><UDim2 name="Size"><XS>1.0</XS><XO>0</XO><YS>1.0</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><token name="Style">0</token><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties><Item class="Folder" referent="RBXV0700000000000000000000000002E3"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">GUI</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ImageLabel" ref