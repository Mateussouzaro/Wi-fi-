urceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV06000000000000000000000000032C"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">RunningLights</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV06000000000000000000000000032D"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Right</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="NumberValue" referent="RBXV06000000000000000000000000032E"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Headlights</string><int64 name="SourceAssetId">-1</int64><double name="Value">0.0</double></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBXV06000000000000000000000000032F"><Properties><bool name="DefinesCapabilities">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Configuration</string><string name="ScriptGuid">{373F46E2-792E-4254-B4A4-151D827375A1}</string><ProtectedString name="Source"><![CDATA[--[[

