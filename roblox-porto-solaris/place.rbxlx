psDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/RobotoMono.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><float name="LineHeight">1.0</float><string name="LocalizationMatchIdentifier"></string><string name="LocalizationMatchedSourceText"></string><int name="MaxVisibleGraphemes">-1</int><string name="Name">Text</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><string name="OpenTypeFeatures"></string><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0.5</YS><YO>0</YO></UDim2><bool name="RichText">false</bool><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0.0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><UDim2 name="Size"><XS>1.0</XS><XO>0</XO><YS>1.0</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><string name="Text">Press "N" to start</string><Color3 name="TextColor3"><R>1.0</R><G>1.0</G><B>1.0</B></Color3><token name="TextDirection">0</token><bool name="TextScaled">true</bool><float name="TextSize">14.0</float><Color3 name="TextStrokeColor3"><R>0.0</R><G>0.0</G><B>0.0</B></Color3><float name="TextStrokeTransparency">1.0</float><float name="TextTransparency">0.0</float><token name="TextTruncate">0</token><bool name="TextWrapped">true</bool><token name="TextXAlignment">2</token><token name="TextYAlignment">1</token><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties></Item></Item><Item class="LocalScript" referent="RBXV0100000000000000000000000001AA"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">UI_Script</string><token name="RunContext">0</token><string name="ScriptGuid">{5DED3A2E-D2D7-4148-8727-AD9576A1E5B1}</string><ProtectedString name="Source"><![CDATA[--[[
	    ___      _______                _       _______       ________  _______  __    _______   _   _   __
	   / _ |____/ ___/ /  ___ ____ ___ (_)__   /__  __/    /  /  ____/ / ___  / / /   /__  __/  / / / / / /
	  / __ /___/ /__/ _ \/ _ `(_-<(_-</ (_-<     / /      /   /  /___  / /__/ / / /___   / /    / /_/ / / /
	 /_/ |_|   \___/_//_/\_,_/___/___/_/___/	/_/      /    /______/ /______/ /_____/  /_/    /_____/ /_/  Version 2 PRODUCTION
	 
						SecondLogic @ Inspare
						Avxnturador @ Novena
						Ono_Three   @ Colt Automotive
]]


local autoscaling	= true					--Estimates top speed

local UNITS	= {								--Click on speed to change units
											--First unit is default	
	{
		units			= "MPH"				,
		scaling			= (10/12) * (60/88)	, -- 1 stud : 10 inches | ft/s to MPH
		maxSpeed		= 230				,
		spInc			= 20				, -- Increment between labelled notches
	},

	{
		units			= "KM/H"			,
		scaling			= (10/12) * 1.09728	, -- 1 stud : 10 inches | ft/s to KP/H
		maxSpeed		= 370				,
		spInc			= 40				, -- Increment between labelled notches
	},

	{
		units			= "SPS"				,
		scaling			= 1					, -- Roblox standard
		maxSpeed		= 400				,
		spInc			= 40				, -- Increment between labelled notches
	}
}

-----------------------------------------------------------------------------------------------

local player=game.Players.LocalPlayer
local mouse=player:GetMouse()

local car = script.Parent.Parent.Car.Value
local _Tune = require(car["A-Chassis Tune"])

local gauges = script.Parent
local values = script.Parent.Parent.Values
local isOn = car.DriveSeat.IsOn

local userInputService = game:GetService("UserInputService")
local cluster = car.Body.Interior.Screens.Left.Main.Gauge
local handler = car.DriveSeat:WaitForChild("Filter")

local LS = false
local RS = false

car.DriveSeat.HeadsUpDisplay = false

local _pRPM = _Tune.PeakRPM
local _lRPM = _Tune.Redline

if not _Tune.Engine and _Tune.Electric then _lRPM = _Tune.E_Redline _pRPM = _Tune.E_Trans2 script.Parent.Values.SLEnabled.Value = false end

local currentUnits = 1
local revEnd = math.ceil(_lRPM/1000)

--Automatic Gauge Scaling
if autoscaling then
	local Drive={}
	if _Tune.Config == "FWD" or _Tune.Config == "AWD" then
		if car.Wheels:FindFirstChild("FL")~= nil then
			table.insert(Drive,car.Wheels.FL)
		end
		if car.Wheels:FindFirstChild("FR")~= nil then
			table.insert(Drive,car.Wheels.FR)
		end
		if car.Wheels:FindFirstChild("F")~= nil then
			table.insert(Drive,car.Wheels.F)
		end
	end
	if _Tune.Config == "RWD" or _Tune.Config == "AWD" then
		if car.Wheels:FindFirstChild("RL")~= nil then
			table.insert(Drive,car.Wheels.RL)
		end
		if car.Wheels:FindFirstChild("RR")~= nil then
			table.insert(Drive,car.Wheels.RR)
		end
		if car.Wheels:FindFirstChild("R")~= nil then
			table.insert(Drive,car.Wheels.R)
		end
	end

	local wDia = 0
	for i,v in pairs(Drive) do
		if v.Size.x>wDia then wDia = v.Size.x end
	end
	Drive = nil
	for i,v in pairs(UNITS) do
		v.maxSpeed = math.ceil(v.scaling*wDia*math.pi*_lRPM/60/_Tune.Ratios[#_Tune.Ratios]/_Tune.FinalDrive/_Tune.FDMult)
		v.spInc = math.max(math.ceil(v.maxSpeed/150)*10,10)
	end
end

if _Tune.Engine == true then
	for i=0,revEnd*2 do
		local ln = gauges.ln:clone()
		ln.Parent = gauges.Tachometer.Tach
		ln.Rotation = 66 + i * 225 / (revEnd*2)
		ln.Num.Text = i/2
		ln.Num.Rotation = -ln.Rotation
		ln.Num.TextScaled = false
		ln.Num.TextSize = 14
		if i*600>=math.ceil(_lRPM/1000)*1000 then
			ln.Num.TextColor3 = Color3.fromRGB(255,50,50)
		end
		if i%2==0 then
			ln.Num.Visible = true
		else
			ln.Num:Destroy()
		end
		ln.Visible=true
	end
else
	for i,v in pairs(UNITS) do
		local lnn = Instance.new("Frame",gauges.Tachometer.Tach)
		lnn.BackgroundTransparency = 1
		lnn.BorderSizePixel = 0
		lnn.Size = UDim2.new(1,0,1,0)
		lnn.Name = v.units
		if i~= 1 then lnn.Visible=false end
		for i=0,v.maxSpeed,v.spInc do
			local ln = gauges.ln:clone()
			ln.Parent = lnn
			ln.Rotation = 66 + 230*(i/v.maxSpeed)
			ln.Num.Text = i
			ln.Num.Rotation = -ln.Rotation
			ln.Num.Visible=true
			ln.Num.TextScaled = false
			ln.Num.TextSize = 12
			ln.Visible=true
		end
	end
end

gauges.ln:Destroy()

values.Gear.Changed:connect(function()
	local gearText = gauges.Tachometer.Gear
	if values.Gear.Value == -1 then
		gearText.Text = "R"
		
		if _Tune.Electric == true then
			local n = math.random(1,40) --(DONT TOUCH - if you used ctrl+f to find this ur Not Cool)
			if n == 10 then
				car.DriveSeat.Reverse.SoundId = "rbxassetid://3484212191"
			else
				car.DriveSeat.Reverse.SoundId = "rbxassetid://5314591030"
			end
		end
	elseif values.Gear.Value == 0 then
		gearText.Text = "N"
	else
		if values.TransmissionMode.Value == "Auto" then
			gearText.Text = "D"
		else
			gearText.Text = values.Gear.Value
		end
	end
	handler:FireServer('UpdateGear','Gear', gearText.Text)
end)

values.TCS.Changed:connect(function()
	if _Tune.TCSEnabled then
		if values.TCS.Value then
			gauges.TCS.Visible = true
			if values.TCSActive.Value then
				wait()
				gauges.TCS.Visible = not gauges.TCS.Visible
			else
				wait()
				gauges.TCS.Visible = false
			end
		else
			gauges.TCS.Visible = true
		end
	else
		gauges.TCS.Visible = false
	end
end)

values.TCSActive.Changed:connect(function()
	if _Tune.TCSEnabled then
		if values.TCSActive.Value and values.TCS.Value then
			wait()
			gauges.TCS.Visible = not gauges.TCS.Visible
		elseif not values.TCS.Value then
			wait()
			gauges.TCS.Visible = true
		else
			wait()
			gauges.TCS.Visible = false
		end
	else
		gauges.TCS.Visible = false
	end
end)

gauges.TCS.Changed:connect(function()
	if _Tune.TCSEnabled then
		if values.TCSActive.Value and values.TCS.Value then
			wait()
			gauges.TCS.Visible = not gauges.TCS.Visible
		elseif not values.TCS.Value then
			wait()
			gauges.TCS.Visible = true
		end
	else
		if gauges.TCS.Visible then
			gauges.TCS.Visible = false
		end
	end
end)

values.ABS.Changed:connect(function()
	if _Tune.ABSEnabled then
		if values.ABS.Value then
			gauges.ABS.Visible = false
			if values.ABSActive.Value then
				wait()
				gauges.ABS.Visible = not gauges.ABS.Visible
			else
				wait()
				gauges.ABS.Visible = false
			end
		else
			gauges.ABS.Visible = true
		end
	else
		gauges.ABS.Visible = false
	end
end)

values.ABSActive.Changed:connect(function()
	if _Tune.ABSEnabled then
		if values.ABSActive.Value and values.ABS.Value then
			wait()
			gauges.ABS.Visible = not gauges.ABS.Visible
		elseif not values.ABS.Value then
			wait()
			gauges.ABS.Visible = true
		else
			wait()
			gauges.ABS.Visible = false
		end
	else
		gauges.ABS.Visible = false
	end
end)

gauges.ABS.Changed:connect(function()
	if _Tune.ABSEnabled then
		if values.ABSActive.Value and values.ABS.Value then
			wait()
			gauges.ABS.Visible = not gauges.ABS.Visible
		elseif not values.ABS.Value then
			wait()
			gauges.ABS.Visible = true
		end
	else
		if gauges.ABS.Visible then
			gauges.ABS.Visible = false
		end
	end
end)

gauges.Values.Stall.Changed:Connect(function()
	if gauges.Values.Stall.Value == true then
		script.Parent.Notification.Visible = true
		Notification(Color3.fromRGB(255,50,50), "VEHICLE STALLED")
	end
end)

values.Velocity.Changed:connect(function(property)
	if _Tune.Engine == false then
		gauges.Tachometer.Tach.Needle.Rotation = 66 + 225 * math.min(1,UNITS[currentUnits].scaling*values.Velocity.Value.Magnitude/UNITS[currentUnits].maxSpeed)
	end
	gauges.Speed.Text = math.floor(UNITS[currentUnits].scaling*car.DriveSeat.Velocity.Magnitude)
	handler:FireServer('UpdateSpeed', 'Speed', gauges.Speed.Text)
end)

values.RPM.Changed:connect(function()
	if gauges.Values.SLEnabled.Value == true then
		if values.Gear.Value > 0 and values.Gear.Value < 6 then
			if values.RPM.Value > _Tune.PeakRPM + 800 then
				gauges.Tachometer.Shift.Visible = true
				gauges.ShiftBeep:Play()
				cluster.Rev.BackgroundColor3 = Color3.fromRGB(255,56,59)
			else
				gauges.Tachometer.Shift.Visible = false
				cluster.Rev.BackgroundColor3 = Color3.fromRGB(154,255,248)
			end
		else
			gauges.Tachometer.Shift.Visible = false
			cluster.Rev.BackgroundColor3 = Color3.fromRGB(154,255,248)
		end
	else
		gauges.Tachometer.Shift.Visible = false
		cluster.Rev.BackgroundColor3 = Color3.fromRGB(154,255,248)
	end

	local s = 0 + 0.548 * math.min(1,values.RPM.Value / (revEnd*1000))
	gauges.Tachometer.Tach.Needle.Rotation = 66 + 225 * math.min(1,values.RPM.Value / (revEnd*1000))
	cluster.Rev.Size = UDim2.new(s,0,0.23,0)
	handler:FireServer('UpdateCluster','Tachometer', UDim2.new(s,0,0.23,0))
	
	if _Tune.Engine == true then
		gauges.Tachometer.Tach.Needle.Rotation = 66 + 225 * math.min(1,values.RPM.Value / (revEnd*1000))
	end
end)

function PBrake()
	gauges.PBrake.Visible = values.PBrake.Value
end
values.PBrake.Changed:connect(PBrake)

function TMode()
	if values.TransmissionMode.Value == "Auto" then
		gauges.Tachometer.Mode.Text = "AUTO"
		if values.Gear.Value > 0 then
			gauges.Tachometer.Gear.Text = "D"
		end
	elseif values.TransmissionMode.Value == "Semi" then
		gauges.Tachometer.Mode.Text = "SEMI"
		if values.Gear.Value > 0 then
			gauges.Tachometer.Gear.Text = values.Gear.Value
		end
	else
		gauges.Tachometer.Mode.Text = "MANUAL"
		if values.Gear.Value > 0 then
			gauges.Tachometer.Gear.Text = values.Gear.Value
		end
	end
end
values.TransmissionMode.Changed:connect(TMode)

function NightMode(tog)
	if tog == "On" then
		for i, v in pairs(gauges:GetChildren()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				v.TextTransparency = 0.3
			elseif v:IsA("ImageLabel") then
				v.ImageTransparency = 0.3
			end	
		end
		for i, v in pairs(gauges.Tachometer:GetChildren()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				v.TextTransparency = 0.3
			elseif v:IsA("ImageLabel") then
				v.ImageTransparency = 0.3
			end	
		end
		for i, v in pairs(gauges:GetChildren()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				v.TextTransparency = 0.3
			elseif v:IsA("ImageLabel") then
				v.ImageTransparency = 0.3
			end	
		end
		for i, v in pairs(gauges.Tachometer:GetChildren()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				v.TextTransparency = 0.3
			elseif v:IsA("ImageLabel") then
				v.ImageTransparency = 0.3
			end	
		end
	elseif tog == "Off" then
		for i, v in pairs(gauges:GetChildren()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				v.TextTransparency = 0
			elseif v:IsA("ImageLabel") then
				v.ImageTransparency = 0
			end	
		end
		for i, v in pairs(gauges.Tachometer:GetChildren()) do
			if v:IsA("TextLabel") or v:IsA("TextButton") then
				v.TextTransparency = 0
			elseif v:IsA("ImageLabel") then
				v.ImageTransparency = 0
			end	
		end
	end
end
if car.DriveSeat.Values.Lights.Value == true then
	NightMode("On")
end
car.DriveSeat.Values.Lights.Changed:connect(function()
	if car.DriveSeat.Values.Lights.Value == true then
		NightMode("On")
	else
		NightMode("Off")
	end
end)

function Left()
	if car.DriveSeat.Values.LI.Value == true then
		gauges.Left.Visible = true
	else
		gauges.Left.Visible = false
	end
end
car.DriveSeat.Values.LI.Changed:connect(Left)

function Right()
	if car.DriveSeat.Values.RI.Value == true then
		gauges.Right.Visible = true
	else
		gauges.Right.Visible = false
	end
end
car.DriveSeat.Values.RI.Changed:connect(Right)

function Notification(color,text)
	local NB = script.Parent.Notification

	NB.ImageColor3 = color
	NB.Text.Text = text
end

local menuopen = false

if car.DriveSeat.IsOn.Value == false then
	script.Parent.Notification.Visible = true
	Notification(Color3.fromRGB(100,255,100), 'Press "N" to start')
end

mouse.KeyDown:connect(function(key)
	if key=="v" then
		gauges.Visible=not gauges.Visible
	elseif key == "n" then
		gauges.Values.Stall.Value = false
		if car.DriveSeat.IsOn.Value == false then
			car.DriveSeat.IsOn.Value = true
			handler:FireServer("Start")
			script.Parent.Notification.Visible = false
			Notification(Color3.fromRGB(255,255,255), " ")
		else
			car.DriveSeat.IsOn.Value = false
			handler:FireServer("Start")
			script.Parent.Notification.Visible = true
			Notification(Color3.fromRGB(100,255,100), 'Press "N" to start')
		end
	end
end)

gauges.LD.MouseButton1Down:Connect(function()
	handler:FireServer('UpdateWindows', 'LD')
end)

gauges.RD.MouseButton1Down:Connect(function()
	handler:FireServer('UpdateWindows', 'RD')
end)

gauges.Units.MouseButton1Click:connect(function()
	if currentUnits==#UNITS then
		currentUnits = 1
	else
		currentUnits = currentUnits+1
	end
	if _Tune.Electric == true then
		for i,v in pairs(gauges.Tachometer.Tach:GetChildren()) do
			v.Visible=v.Name==UNITS[currentUnits].units or v.Name=="Needle" or v.Name=="lns"
		end
	end
	gauges.Speed.Text = math.floor(UNITS[currentUnits].scaling*values.Velocity.Value.Magnitude)
	gauges.Units.Text = UNITS[currentUnits].units
	handler:FireServer('UpdateUnits','Units', gauges.Units.Text)
end)

script.Parent.CC.MouseButton1Click:connect(function()
	local speed = math.floor((10/12) * (60/88)*(car.DriveSeat.Velocity.Magnitude))
	if values.Gear.Value > 0 and speed > 19 then
		values.CC.Value = not values.CC.Value
		values.CCS.Value = speed
		if values.CCS.Value < 0 then
			values.CCS.Value = 0
		end
	end
end)

values.CC.Changed:connect(function()
	if values.CC.Value == true and car.DriveSeat.IsOn.Value == true then
		Notification(Color3.fromRGB(0,120,255), "CRUISE")
		gauges.Notification.Visible = true
		gauges.Speed.TextColor3 = Color3.fromRGB(90,255,90)
		gauges.Units.TextColor3 = Color3.fromRGB(90,255,90)
	else
		Notification(Color3.fromRGB(255,255,255), " ")
		gauges.Notification.Visible = false
		gauges.Speed.TextColor3 = Color3.fromRGB(235, 255, 254)
		gauges.Units.TextColor3 = Color3.fromRGB(235, 255, 254)
	end
end)

function LBSW(bool)
	if bool == true then
		gauges.LBSW.ImageColor3 = Color3.new(1,170/255,0)
		gauges.LBSW.ImageTransparency = 0
		LS = true
	else
		gauges.LBSW.ImageColor3 = Color3.fromRGB(235,255,254)
		if car.DriveSeat.Values.Lights.Value == true then
			gauges.LBSW.ImageTransparency = 0.3
		else
			gauges.LBSW.ImageTransparency = 0
		end
		LS = false
	end
end

function RBSW(bool)
	if bool == true then
		gauges.RBSW.ImageColor3 = Color3.new(1,170/255,0)
		gauges.RBSW.ImageTransparency = 0
		RS = true
	else
		gauges.RBSW.ImageColor3 = Color3.fromRGB(235,255,254)
		if car.DriveSeat.Values.Lights.Value == true then
			gauges.RBSW.ImageTransparency = 0.3
		else
			gauges.RBSW.ImageTransparency = 0
		end
		RS = false
	end
end

car.DriveSeat.Clink.Changed:connect(function() --Not exactly the most efficent way but it works
	if car.DriveSeat.Clink.Playing == true then
		if LS == true or RS == true then
			gauges.FastWarn:Play()
		end
	end
end)

local carName = car.Name
if carName:match("Colt") then else
	script.Parent.Parent:Destroy()
	warn("COLTUI V2: Retrofit Detected; functions have been disabled.")
end

wait(.1)
TMode()
PBrake()

while wait() do
	local sensors = car.Body.Sensors
	local speed = car.DriveSeat.Velocity.Magnitude

	local rlcs = sensors.RLCS.RayStart --rear corner sensors
	local rlcse = sensors.RLCS.RayEnd
	local rrcs = sensors.RRCS.RayStart
	local rrcse = sensors.RRCS.RayEnd
	
	if speed > 30 and car.DriveSeat.Values.Lock.Value == false and car.DriveSeat.Values.ADL.Value == true then --auto door locks
		handler:FireServer("Security", "AutoLock")
	elseif speed < 3 and values.Gear.Value < 1 and car.DriveSeat.Values.Lock.Value == true then
		handler:FireServer("Security", "AutoUnlock")
	end
	
	if gauges.Values.BSMEnabled.Value == true and car.DriveSeat.IsOn.Value == true then --Blind spot monitoring
		if speed > 20 then
			if workspace:FindPartOnRay(Ray.new(rlcse.CFrame.p,(rlcse.CFrame.p-rlcs.CFrame.p).unit * 18)) then
				local p = workspace:FindPartOnRay(Ray.new(rlcse.CFrame.p,(rlcse.CFrame.p-rlcs.CFrame.p).unit * 18))
				if p.Velocity.Magnitude > 20 then
					if LS == false then
						LBSW(true)
					end
				else
					LBSW(false)
				end
			else
				LBSW(false)
			end
			if workspace:FindPartOnRay(Ray.new(rrcse.CFrame.p,(rrcse.CFrame.p-rrcs.CFrame.p).unit * 18)) then
				local p = workspace:FindPartOnRay(Ray.new(rrcse.CFrame.p,(rrcse.CFrame.p-rrcs.CFrame.p).unit * 18))
				if p.Velocity.Magnitude > 20 then
					if RS == false then
						RBSW(true)
					end
				else
					RBSW(false)
				end
			else
				RBSW(false)
			end
		else
			LBSW(false)
			RBSW(false)
		end
	end
end

