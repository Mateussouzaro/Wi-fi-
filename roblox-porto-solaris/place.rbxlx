name="SourceAssetId">-1</int64></Properties><Item class="BoolValue" referent="RBXV010000000000000000000000000233"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">RI</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV010000000000000000000000000234"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">LI</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV010000000000000000000000000235"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Lights</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV010000000000000000000000000236"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">AA</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV010000000000000000000000000237"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Lock</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV010000000000000000000000000238"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">AL</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="Folder" referent="RBXV010000000000000000000000000239"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Windows</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="BoolValue" referent="RBXV01000000000000000000000000023A"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">LD</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV01000000000000000000000000023B"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">RD</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item></Item><Item class="BoolValue" referent="RBXV01000000000000000000000000023C"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">ALS</string><int64 name="SourceAssetId">-1</int64><bool name="Value">true</bool></Properties></Item><Item class="BoolValue" referent="RBXV01000000000000000000000000023D"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">ADL</string><int64 name="SourceAssetId">-1</int64><bool name="Value">true</bool></Properties></Item></Item><Item class="Script" referent="RBXV01000000000000000000000000023E"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Gui Giver</string><token name="RunContext">0</token><string name="ScriptGuid">{6B8661F4-9CEA-40C3-AECC-88307003D9E1}</string><ProtectedString name="Source"><![CDATA[GUI = script.Parent.Screen
car = script.Parent.Parent
body = car.Body.Lights
TK = car.Misc.Doors.Trunk.Parts.Lights

driver = false

script.Parent.ChildAdded:connect(function(child)
	if child.Name == "SeatWeld" then
		if child.Part1.Name == "HumanoidRootPart" then
			player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
			if player and (not player.PlayerGui:FindFirstChild("Screen")) then --// The part after the "and" prevents multiple GUI's to be copied over.
				GUI.CarSeat.Value = script.Parent --// Puts a reference of the seat in this ObjectValue, now you can use this ObjectValue's value to find the car directly.
				GUI:Clone().Parent = player.PlayerGui --// Compact version
			end
		end
	end
	driver = true
end)

script.Parent.ChildRemoved:connect(function(child)
	if child.Name == "SeatWeld" then
		if child.Part1.Name == "HumanoidRootPart" then
			player = game.Players:GetPlayerFromCharacter(child.Part1.Parent)
			if player and player.PlayerGui:FindFirstChild("Screen") then
				player.PlayerGui:FindFirstChild("Screen"):Destroy()
			end
		end
	end	
	driver = false
end)

car.DriveSeat.IsOn.Changed:Connect(function()
	if car.DriveSeat.IsOn.Value == false and car.DriveSeat.Values.Lights.Value == true then
		wait(300) -- 5 Minutes
		car.DriveSeat.Values.Lights.Value = false
		body.FL1.BrickColor = BrickColor.new("Really black")
		body.FL1.Material = "Glass"
		body.FL2.BrickColor = BrickColor.new("Really black")
		body.FL2.Material = "Glass"
		body.RL.BrickColor = BrickColor.new("Mid gray")
		body.RL.Material = "SmoothPlastic"
		TK.RL.Transparency = 1

		car.DriveSeat.Values.Lights.Value = false
		body.FL1.Light.Enabled = false
		body.FL2.Light.Enabled = false
		TK.RLL.Light.Enabled = false
	end
end)

while wait() do
	if driver == false then
		if car.DriveSeat.Values.AA.Value == true then
			for i, w in pairs(car.Wheels:GetChildren()) do
				if w.Name=="F" then
					w.Arm.Steer.CFrame=car.Wheels.F.Base.CFrame*CFrame.Angles(0,0,0)
				elseif w.Name=="FL" then
					w.Arm.Steer.CFrame=car.Wheels.FL.Base.CFrame*CFrame.Angles(0,0,0)
				elseif w.Name=="FR" then
					w.Arm.Steer.CFrame=car.Wheels.FR.Base.CFrame*CFrame.Angles(0,0,0,0)
				end
			end
		end
	end
end]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV01000000000000000000000000023F"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">TheFix</string><token name="RunContext">0</token><string name="ScriptGuid">{E77F3379-2AF4-4652-B3A7-91B42FCF397C}</string><ProtectedString name="Source"><![CDATA[wait(2)
script.Parent.Disabled = false]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="BoolValue" referent="RBXV010000000000000000000000000240"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">IsOn</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="RemoteEvent" referent="RBXV010000000000000000000000000241"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Filter</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV010000000000000000000000000242"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Handler</string><token name="RunContext">0</token><string name="ScriptGuid">{3779E939-D366-4345-B9D6-8F517DA8FB37}</string><ProtectedString name="Source"><![CDATA[local F = {}
local car = script.Parent.Parent.Parent
local carSeat = car.DriveSeat
local screens = car.Body.Interior.Screens
local BlinkersEnabled = true
local player = nil
local TweenService = game:GetService("TweenService")

function animation() --idk how to script this is the best i could do Give me a break smh
	local start = UDim2.new(0,0,1,0)
	local goal = UDim2.new(0,0,0.2,0)
	local gaugestart = UDim2.new(0,0,1,0)
	local gaugegoal = UDim2.new(0,0,0.04,0)
	local tachstart = UDim2.new(0,0,1,0)
	local tachgoal = UDim2.new(0,0,0,0)
	local coltinfo = TweenInfo.new(1.5)
	local colton = TweenService:Create(screens.Mid.Startup.Logo.Logo, coltinfo, {ImageTransparency = 0})
	local coltoff = TweenService:Create(screens.Mid.Startup.Logo.Logo, coltinfo, {ImageTransparency = 1})
	if car.DriveSeat.IsOn.Value == true then
		screens.MP.Screen.Enabled = true
		screens.Left.Main.Gradient:TweenPosition(goal)
		screens.Mid.Main.Gradient:TweenPosition(goal)
		screens.Right.Main.Gradient:TweenPosition(goal)
		colton:Play()
		wait(3)
		if car.DriveSeat.IsOn.Value == true then
			coltoff:Play()
			wait(1)
			if car.DriveSeat.IsOn.Value == true then
				screens.Left.Main.Gauge:TweenPosition(tachgoal)
				screens.Left.Gauges.Units:TweenPosition(tachgoal)
				screens.Mid.Main.Indicators:TweenPosition(tachgoal)
				screens.Right.Main.Song:TweenPosition(tachgoal)
			end
		end
	else
		screens.MP.Screen.Enabled = false
		coltoff:Play()
		screens.Left.Main.Gradient:TweenPosition(start)
		screens.Mid.Main.Gradient:TweenPosition(start)
		screens.Right.Main.Gradient:TweenPosition(start)
		screens.Left.Main.Gauge:TweenPosition(tachstart)
		screens.Left.Gauges.Units:TweenPosition(tachstart)
		screens.Mid.Main.Indicators:TweenPosition(tachstart)
		screens.Right.Main.Song:TweenPosition(tachstart)
	end
end

F.Start = function()
	if car.DriveSeat.IsOn.Value == false then
		car.DriveSeat.IsOn.Value = true
		car.DriveSeat.Startup:Play()
		car.DriveSeat.Chime:Play()
		car.Body.Lights.LDRL.Material = "Neon"
		car.Body.Lights.RDRL.Material = "Neon"
		carSeat.Rev.Volume = 1
		car.Body.Interior.Screens.Left.Ajar.Volume = 0.25
		animation()
	else
		car.DriveSeat.IsOn.Value = false
		car.DriveSeat.Startup:Stop()
		car.DriveSeat.Chime:Stop()
		car.Body.Lights.LDRL.Material = "SmoothPlastic"
		car.Body.Lights.RDRL.Material = "SmoothPlastic"
		carSeat.Rev.Volume = 0
		car.Body.Interior.Screens.Left.Ajar.Volume = 0
		animation()
	end
end

F.trunk = function(bool)
	car.Misc.Doors.Trunk.SS.Motor.DesiredAngle = bool and -1 or 0
end

F.Security = function(typ)
	if typ == "Lock" then
		car.DriveSeat.LockChime:Play()
		car.DriveSeat.Anchored = true
		car.DriveSeat.Values.Lock.Value = true
		car.DriveSeat.DoorLock:Play()
		for i, v in pairs(car.Misc.Doors.Trunk:GetDescendants()) do
			if v.Name == "Handle" then
				v.ClickDetector.MaxActivationDistance = 0
			end
		end
		for i, v in pairs(car:GetDescendants()) do
			if v:IsA("VehicleSeat") then
				v.Disabled = true
			end
		end
	elseif typ == "Unlock" then
		car.DriveSeat.LockChime:Play()
		car.DriveSeat.Anchored = false
		car.DriveSeat.Values.Lock.Value = false
		car.DriveSeat.DoorLock:Play()
		for i, v in pairs(car.Misc.Doors.Trunk:GetDescendants()) do
			if v.Name == "Handle" then
				v.ClickDetector.MaxActivationDistance = 8.5
			end
		end
		for i, v in pairs(car:GetDescendants()) do
			if v:IsA("VehicleSeat") then
				v.Disabled = false
			end
		end
		wait(1/3)
		carSeat.LockChime:Play()
	elseif typ == "AutoLock" then
		car.DriveSeat.Values.Lock.Value = true
		car.DriveSeat.DoorLock:Play()
		for i, v in pairs(car.Misc.Doors.Trunk:GetDescendants()) do
			if v.Name == "Handle" then
				v.ClickDetector.MaxActivationDistance = 0
			end
		end
	elseif typ == "AutoUnlock" then
		car.DriveSeat.Values.Lock.Value = false
		car.DriveSeat.DoorLock:Play()
		for i, v in pairs(car.Misc.Doors.Trunk:GetDescendants()) do
			if v.Name == "Handle" then
				v.ClickDetector.MaxActivationDistance = 0
			end
		end
	end
end

F.fm = function(ok)
	for i, v in pairs(car.Body.Speakers:GetChildren()) do
		if v.Name == "AudioPart" then
			v.Sound:Stop()
		end
	end
	carSeat.Stations.mood.Value = ok
end

F.Sound = function(x)
	for i, v in pairs(car.Body.Speakers:GetDescendants()) do
		if v.Name == "AudioPart" then
			v.Sound:Stop()
			wait()
			v.Sound.SoundId = "rbxassetid://"..x
			wait()
			v.Sound:Play()
		end
	end
end

F.UpdateInfo = function(value)
	screens.Right.Main.Song.TextBox.Text = value
end

F.SoundPause = function(x)
	for i, v in pairs(car.Body.Speakers:GetDescendants()) do
		if v.Name == "AudioPart" then
			v.Sound:Pause()
		end
	end
end

F.SoundStop = function(x)
	for i, v in pairs(car.Body.Speakers:GetDescendants()) do
		if v.Name == "AudioPart" then
			v.Sound:Stop()
		end
	end
end

F.SoundResume = function(x)
	for i, v in pairs(car.Body.Speakers:GetDescendants()) do
		if v.Name == "AudioPart" then
			v.Sound:Resume()
		end
	end
end

F.Volume = function(x)
	for i, v in pairs(car.Body.Speakers:GetDescendants()) do
		if v.Name == "AudioPart" then
			v.Sound.Volume = x
		end
	end
end

F.Pitch = function(x)
	for i, v in pairs(car.Body.Speakers:GetDescendants()) do
		if v.Name == "AudioPart" then
			v.Sound.PlaybackSpeed = x
		end
	end
end

F.ambient = function(lights, bool)
	if lights == "footwell" then
		for i, v in pairs(car.Body.Underlight:GetChildren()) do
			if v.ClassName == "Beam" then
				v.Enabled = bool
			end
		end
	end
end

F.colors = function(lights, value)
	if lights == "dash" then
		for i,v in pairs(screens:GetDescendants()) do
			if v.Name == "Gradient" then
				v.ImageColor3 = value
			end
		end
	elseif lights == "footwell" then
		for i, v in pairs(car.Body.Underlight:GetChildren()) do
			if v.ClassName == "Beam" then
				v.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, value),
					ColorSequenceKeypoint.new(1, value),
				})
			end
		end
	end
end

F.GradientTransparency = function(value)
	for i, v in pairs(screens:GetDescendants()) do
		if v.Name == "Gradient" then
			v.ImageTransparency = value
		end
	end
end

F.UpdateWindows = function(typ)
	local LM = car.Misc.Doors.LD.SS2:WaitForChild('Motor')
	local RM = car.Misc.Doors.RD.SS2:WaitForChild('Motor')
	
	if typ == "LD" then
		if car.DriveSeat.Values.Windows.LD.Value == false then
			car.DriveSeat.Values.Windows.LD.Value = true
			LM.DesiredAngle = -0.4
		else
			car.DriveSeat.Values.Windows.LD.Value = false
			LM.DesiredAngle = 0
		end
	elseif typ == "RD" then
		if car.DriveSeat.Values.Windows.RD.Value == false then
			car.DriveSeat.Values.Windows.RD.Value = true
			RM.DesiredAngle = -0.4
		else
			car.DriveSeat.Values.Windows.RD.Value = false
			RM.DesiredAngle = 0
		end
	end
end

F.UpdateCluster = function(value, tSize)
	if value == "Tachometer" then
		screens.Left.Main.Gauge.Rev.Size = tSize
	end
end

F.UpdateSpeed = function(typ, speed)
	if typ == "Speed" then
		screens.Left.Gauges.Units.Speed.Text = speed
	end
end

F.UpdateGear = function(typ, gear)
	if typ == "Gear" then
		screens.Left.Gauges.Units.Gear.Text = gear
	end
end

F.UpdateUnits = function(typ, units)
	if typ == "Units" then
		screens.Left.Gauges.Units.Unit.Text = units
	end
end

F.value = function(target)
	target.Value = not target.Value
end

script.Parent.OnServerEvent:connect(function(Player, Func, ...)
	if F[Func] then
		F[Func](...)
	end
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="ScreenGui" referent="RBXV010000000000000000000000000243"><Properties><bool name="AutoLocalize">true</bool><bool name="ClipToDeviceSafeArea">true</bool><bool name="DefinesCapabilities">false</bool><int name="DisplayOrder">0</int><bool name="Enabled">true</bool><string name="Name">Screen</string><bool name="ResetOnSpawn">true</bool><Ref name="RootLocalizationTable">null</Ref><token name="SafeAreaCompatibility">1</token><token name="ScreenInsets">2</token><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><int64 name="SourceAssetId">-1</int64><token name="ZIndexBehavior">0</token></Properties><Item class="LocalScript" referent="RBXV010000000000000000000000000244"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">GuiScript</string><token name="RunContext">0</token><string name="ScriptGuid">{420E1807-1EA2-407B-A688-311983C87D78}</string><ProtectedString name="Source"><![CDATA[--// SS3 controls for AC6 by Itzt, originally for 2014 Infiniti QX80. i don't know how to tune ac lol
 
wait(0.1)
local player = game.Players.LocalPlayer
local FE = game.Workspace.FilteringEnabled
local lightOn = false
local Camera = game.Workspace.CurrentCamera
local cam = script.Parent.nxtcam.Value
local carSeat = script.Parent.CarSeat.Value
local car = carSeat.Parent
local mouse = game.Players.LocalPlayer:GetMouse()
local handler = carSeat:WaitForChild('Filter')
local infotainment = script.Parent["Colt Infotainment"]
--local lhandler = carSeat.FE_Lights

local interface = player.PlayerGui:WaitForChild("A-Chassis Interface")

local st = false
local hub = false

-------------------------
 
mouse.KeyDown:connect(function (key)
    key = string.lower(key)
	if key == "g" then
		if hub == false then
			hub = true
			infotainment:TweenPosition(UDim2.new(0.65,0,0.469,0))
		else
			hub = false
			infotainment:TweenPosition(UDim2.new(1,0,0.469,0))
		end
	elseif key == "f" then
		handler:FireServer("value", car.DriveSeat.Values.AA)
	elseif key:byte() == 48 then -- CC
		st = true
	end
end)

game.Lighting.Changed:connect(function(prop)
	if prop == "TimeOfDay" then
	handler:FireServer('TimeUpdate')
	end
end)

if game.Workspace.FilteringEnabled == true then
	handler:FireServer('feON')
elseif game.Workspace.FilteringEnabled == false then
	handler:FireServer('feOFF')
end]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV010000000000000000000000000245"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">TheFix</string><token name="RunContext">0</token><string name="ScriptGuid">{283A3B79-69AF-4467-B5C5-751ADF558EF7}</string><ProtectedString name="Source"><![CDATA[wait(2)
