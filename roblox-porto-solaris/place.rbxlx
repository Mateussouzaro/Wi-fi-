end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item></Item></Item><Item class="ScreenGui" referent="RBXV0100000000000000000000000002D5"><Properties><bool name="AutoLocalize">true</bool><bool name="ClipToDeviceSafeArea">true</bool><bool name="DefinesCapabilities">false</bool><int name="DisplayOrder">0</int><bool name="Enabled">true</bool><string name="Name">A-Chassis Interface</string><bool name="ResetOnSpawn">true</bool><Ref name="RootLocalizationTable">null</Ref><token name="SafeAreaCompatibility">1</token><token name="ScreenInsets">2</token><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><int64 name="SourceAssetId">-1</int64><token name="ZIndexBehavior">0</token></Properties><Item class="ObjectValue" referent="RBXV0100000000000000000000000002D6"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Car</string><int64 name="SourceAssetId">-1</int64><Ref name="Value">null</Ref></Properties></Item><Item class="BoolValue" referent="RBXV0100000000000000000000000002D7"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">IsOn</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="BoolValue" referent="RBXV0100000000000000000000000002D8"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">ControlsOpen</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item><Item class="NumberValue" referent="RBXV0100000000000000000000000002D9"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Version</string><int64 name="SourceAssetId">-1</int64><double name="Value">2.0</double></Properties><Item class="NumberValue" referent="RBXV0100000000000000000000000002DA"><Properties><bool name="Defines