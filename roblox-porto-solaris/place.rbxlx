car.Wheels.FR:WaitForChild("Base")
car.Wheels.FR:WaitForChild("Arm")

while wait() do
	local direction = car.Wheels.FR.Base.CFrame:vectorToObjectSpace(car.Wheels.FR.Arm.CFrame.lookVector)
	local direction2 = car.Wheels.FL.Base.CFrame:vectorToObjectSpace(car.Wheels.FL.Arm.CFrame.lookVector)
	local angle = ((math.atan2(-direction.Z, direction.X))+(math.atan2(-direction2.Z, direction2.X)))/2
	car.Misc.Wheel.W.W.CurrentAngle = (angle-1.57)*9
end]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="LocalScript" referent="RBXV010000000000000000000000000198"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">VulpesLights</string><token name="RunContext">0</token><string name="ScriptGuid">{BE25F4EF-6F45-49B2-8039-129A2E82863A}</string><ProtectedString name="Source"><![CDATA[wait(0.2)
local car = script.Parent.Car.Value
local carSeat = car.DriveSeat
local values = script.Parent.Values
local handler = car:WaitForChild('Lights')
local UIS = game:GetService("UserInputService")
local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local Debounce = false

mouse.KeyDown:connect(function (key)
	key = string.lower(key)
	if key == "l" then
		if car.DriveSeat.Values.Lights.Value == false then
			car.DriveSeat.Values.Lights.Value = true
			handler:FireServer('Lights', 'beam', true)
		else
			car.DriveSeat.Values.Lights.Value = false
			handler:FireServer('Lights', 'beam', false)
		end
	elseif key == 'z' or key:byte() == 1012 then -- left
		if not Debounce then
			Debounce = true
			handler:FireServer('blinkers', 'Left')
			wait(1/3)
			Debounce = false
		end
	elseif key == 'c' or key:byte() == 1013 then -- right
		if not Debounce then
			Debounce = true
			handler:FireServer('blinkers', 'Right')
			wait(1/3)
			Debounce = false
		end
	elseif key == 'x' or key:byte() == 1015 then -- hazards
		if not Debounce then
			Debounce = true
			handler:FireServer('blinkers', 'Hazards')
			wait(1/3)
			Debounce = false
		end
	end
end)

--gamepad compatibility
UIS.InputBegan:Connect(function(key)
	local k = key.KeyCode
	if k == Enum.KeyCode.DPadLeft then
		if not Debounce then
			Debounce = true
			handler:FireServer('blinkers', 'Left')
			wait(1/3)
			Debounce = false
		end
	elseif k == Enum.KeyCode.DPadRight then
		if not Debounce then
			Debounce = true
			handler:FireServer('blinkers', 'Right')
			wait(1/3)
			Debounce = false
		end
	elseif k == Enum.KeyCode.DPadDown then
		if not Debounce then
			Debounce = true
			handler:FireServer('blinkers', 'Hazards')
			wait(1/3)
			Debounce = false
		end
	elseif k == Enum.KeyCode.ButtonB then
		if car.DriveSeat.Values.Lights.Value == false then
			car.DriveSeat.Values.Lights.Value = true
			handler:FireServer('Lights', 'beam', true)
		else
			car.DriveSeat.Values.Lights.Value = false
			handler:FireServer('Lights', 'beam', false)
		end
	end
end)

values.Brake.Changed:connect(function()
	if values.Brake.Value > 0 then
		handler:FireServer('Lights', 'brake', true)
	else
		handler:FireServer('Lights', 'brake', false)
	end
end)

values.Gear.Changed:connect(function()
	if values.Gear.Value == -1 then
		handler:FireServer('Lights', 'reverse', true)
	else
		handler:FireServer('Lights', 'reverse', false)
	end
end)

L = game:GetService("Lighting")

game.Lighting.Changed:Connect(function()
	local l = L:GetMinutesAfterMidnight()/60
	if car.DriveSeat.Values.AL.Value == true then
		if l>17.8 or l<6.5 then
			car.DriveSeat.Values.Lights.Value = true
			handler:FireServer('Lights', 'beam', true)
		else
			car.DriveSeat.Values.Lights.Value = false
			handler:FireServer('Lights', 'beam', false)
		end
	end
	wait()
end)

handler.OnClientEvent:connect(function(...)
	local Args = {...}
	if Args[1] then
		if Args[1] == 'blink' then
			if Args[2] then
				local P = Args[2]
				if Args[3] then
					local Play = Args[3]
					if Play == true then
					elseif Play == false then
					end
				end
			end
		end
	end
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="RemoteEvent" referent="RBXV010000000000000000000000000199"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Lights</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV01000000000000000000000000019A"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Handler</string><token name="RunContext">0</token><string name="ScriptGuid">{5135DDAC-7EE0-4212-B11A-73B8F005F034}</string><ProtectedString name="Source"><![CDATA[local F = {}
local player = nil
local car = script.Parent.Parent
local BlinkersEnabled = true
local TK = car.Misc.Doors.Trunk.Parts.Lights
local body = car.Body.Lights
local screens = car.Body.Interior.Screens

F.Lights = function(lights, bool)
	if lights == 'brake' then
		if car.DriveSeat.Values.Lights.Value then
			TK.RL.Transparency = bool and 0 or 0.5
			TK.Brake.BrickColor = bool and BrickColor.new("Really red") or BrickColor.new("Maroon")
			TK.Brake.Material = bool and "Neon" or "SmoothPlastic"
			body.RL.BrickColor = bool and BrickColor.new("Really red") or BrickColor.new("Crimson")
			body.RL.Material = bool and "Neon" or "SmoothPlastic"
			
			TK.RLL.Brakes.Enabled = bool
		else
			TK.RL.Transparency = bool and 0 or 1
			TK.Brake.BrickColor = bool and BrickColor.new("Really red") or BrickColor.new("Maroon")
			TK.Brake.Material = bool and "Neon" or "SmoothPlastic"
			body.RL.BrickColor = bool and BrickColor.new("Really red") or BrickColor.new("Mid gray")
			body.RL.Material = bool and "Neon" or "SmoothPlastic"
			
			TK.RLL.Brakes.Enabled = bool
		end
	elseif lights == 'beam' then
		body.FL1.BrickColor = bool and BrickColor.new("Institutional white") or BrickColor.new("Really black")
		body.FL1.Material = bool and "Neon" or "Glass"
		body.FL2.BrickColor = bool and BrickColor.new("Institutional white") or BrickColor.new("Really black")
		body.FL2.Material = bool and "Neon" or "Glass"
		body.RL.BrickColor = bool and BrickColor.new("Crimson") or BrickColor.new("Mid gray")
		body.RL.Material = bool and "Neon" or "SmoothPlastic"
		TK.RL.Transparency = bool and 0.5 or 1

		car.DriveSeat.Values.Lights.Value = bool
		body.FL1.Light.Enabled = bool
		body.FL2.Light.Enabled = bool
		TK.RLL.Light.Enabled = bool
	elseif lights == 'reverse' then
		body.Reverse.Material = bool and "Neon" or "SmoothPlastic"
		TK.R1.Transparency = bool and 0 or 1
		TK.R2.Transparency = bool and 0 or 1

		TK.R1.Light.Enabled = bool
		TK.R2.Light.Enabled = bool
	end
end

local b = ''

function Runner(dir,tog)
	if dir == 'Left' then
		body.LDRL.Material = tog and "Neon" or "SmoothPlastic"
		body.LDRL.BrickColor = tog and BrickColor.new("Institutional white") or BrickColor.new("Medium stone grey")
	elseif dir == 'Right' then
		body.RDRL.Material = tog and "Neon" or "SmoothPlastic"
		body.RDRL.BrickColor = tog and BrickColor.new("Institutional white") or BrickColor.new("Medium stone grey")
	end
end

function Toggle(signal, bool)
	if signal == "Left" then
		body.LDRL.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Institutional white")
		body.LDRL.Material = bool and "Neon" or "SmoothPlastic"
		body.RLeft.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Mid gray")
		body.RLeft.Material = bool and "Neon" or "SmoothPlastic"
		TK.RLeft.Transparency = bool and 0 or 1
		
		screens.Left.Gauges.Units.Left.Visible = bool
		
		car.DriveSeat.Values.LI.Value = bool
		body.LDRL.Light.Enabled = bool
		TK.RLeft.Light.Enabled = bool
	elseif signal == "Right" then
		body.RDRL.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Institutional white")
		body.RDRL.Material = bool and "Neon" or "SmoothPlastic"
		body.RRight.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Mid gray")
		body.RRight.Material = bool and "Neon" or "SmoothPlastic"
		TK.RRight.Transparency = bool and 0 or 1

		screens.Left.Gauges.Units.Right.Visible = bool

		car.DriveSeat.Values.RI.Value = bool
		body.RDRL.Light.Enabled = bool
		TK.RRight.Light.Enabled = bool
	elseif signal == "Hazards" then
		body.LDRL.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Institutional white")
		body.LDRL.Material = bool and "Neon" or "SmoothPlastic"
		TK.RLeft.Transparency = bool and 0 or 1
		body.RDRL.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Institutional white")
		body.RDRL.Material = bool and "Neon" or "SmoothPlastic"
		TK.RRight.Transparency = bool and 0 or 1
		body.RLeft.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Mid gray")
		body.RLeft.Material = bool and "Neon" or "SmoothPlastic"
		body.RRight.BrickColor = bool and BrickColor.new("Neon orange") or BrickColor.new("Mid gray")
		body.RRight.Material = bool and "Neon" or "SmoothPlastic"

		screens.Left.Gauges.Units.Left.Visible = bool
		screens.Left.Gauges.Units.Right.Visible = bool

		car.DriveSeat.Values.LI.Value = bool
		car.DriveSeat.Values.RI.Value = bool
		body.LDRL.Light.Enabled = bool
		TK.RLeft.Light.Enabled = bool
		body.RDRL.Light.Enabled = bool
		TK.RRight.Light.Enabled = bool
	end
end

function blink(typ)
	b = typ
	if blinking == true then
		blinking = false
		if typ == "Hazards" then
			car.DriveSeat.Hazards:Play()
		else
			car.DriveSeat.Clunk:Play()
		end
	else
		blinking = true
		Runner(typ, false)
		if typ == "Hazards" then
			car.DriveSeat.Hazards:Play()
		else
			car.DriveSeat.Clink:Play()
		end
		while blinking do
			Toggle(typ, true)
			script.Parent:FireClient(player, 'blink', .9, true)
			car.DriveSeat.Tick:Play()
			wait(1/3)
			Toggle(typ, false)
			script.Parent:FireClient(player, 'blink', 0.8, true)
			car.DriveSeat.Tock:Play()
			wait(1/3)
		end
		Toggle(typ, false)
		script.Parent:FireClient(player, 'blink', .9, false)
		wait(1/9)
		if car.DriveSeat.IsOn.Value == true then
			Runner(typ, true)
		end
	end
end

script.Parent.Parent.ChildRemoved:connect(function(child)
	if child:IsA("Weld") and BlinkersEnabled then
		if blinking == true and b == 'Hazards' then
			return
		else
			blinking = false
		end
	end
end)

F.blinkers = function(bool)
	blink(bool)
end

F.flash = function()
	Toggle('Hazards', true)
	wait(1/3)
	Toggle('Hazards', false)
end

F.alarm = function()
	Toggle('Hazards',true)
	car.DriveSeat.Horn:Play()
	wait(0.8)
	Toggle('Hazards', false)
	car.DriveSeat.Horn:Stop()
end

script.Parent.OnServerEvent:connect(function(pl,Fnc,...)
	player = pl
	F[Fnc](...)
end)]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item></Item><Item class="LocalScript" referent="RBXV01000000000000000000000000019B"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Brake Whistle</string><token name="RunContext">0</token><string name="ScriptGuid">{94A2D68C-F52E-4266-A849-B77EF7240CEF}</string><ProtectedString name="Source"><![CDATA[local car = script.Parent.Car.Value
local handler = car.Brakeoverheat
local FE = workspace.FilteringEnabled
car.DriveSeat.Brakes:Play()

if not FE then
while wait() do
	if script.Parent.Values.Brake.Value > 0.1 and ((car.Wheels.RR.RotVelocity.Magnitude+car.Wheels.FR.RotVelocity.Magnitude+car.Wheels.FL.RotVelocity.Magnitude+car.Wheels.RL.RotVelocity.Magnitude)/4) > 10 and script.Parent.Values.Gear.Value > 0 then
		car.DriveSeat.Brakes.Volume = math.max((script.Parent.Values.Brake.Value/2)-.35,0)
	else
		car.DriveSeat.Brakes.Volume = math.max(car.DriveSeat.Brakes.Volume-.35,0)
	end
end
else
	handler:FireServer("SoundPlay")
	
	while wait() do
		handler:FireServer("SoundUpdate",sound)
		
		if script.Parent.Values.Brake.Value > 0.1 and ((car.Wheels.RR.RotVelocity.Magnitude+car.Wheels.FR.RotVelocity.Magnitude+car.Wheels.FL.RotVelocity.Magnitude+car.Wheels.RL.RotVelocity.Magnitude)/4) > 10 and script.Parent.Values.Gear.Value > 0 then
			sound = math.max((script.Parent.Values.Brake.Value/2)-.35,0)
		else
			sound = math.max(car.DriveSeat.Brakes.Volume-.35,0)
		end		
	end
end]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="RemoteEvent" referent="RBXV01000000000000000000000000019C"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Brakeoverheat</string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="RBXV01000000000000000000000000019D"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">true</bool><Content name="LinkedSource"><null></null></Content><string name="Name">Handler</string><token name="RunContext">0</token><string name="ScriptGuid">{7800CBD3-E945-49C1-A1EB-A0C1C3A58BDA}</string><ProtectedString name="Source"><![CDATA[local F = {}
local DriveSeat = script.Parent.Parent:WaitForChild("DriveSeat")
local car = DriveSeat.Parent

F.SoundUpdate = function(volume)
	if DriveSeat.Brakes.Volume ~= volume then
		DriveSeat.Brakes.Volume = volume
	end
end

F.SoundPlay = function()
	DriveSeat.Brakes:Play()
end

script.Parent.OnServerEvent:connect(function(pl,Fnc,...)
