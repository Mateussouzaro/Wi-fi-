sound.SoundId = "rbxassetid://7169463094"
sound.Volume = 3

--why you shouldn't be an insensitive person :)

game.Players.PlayerAdded:Connect(function(player)
	if player.UserId == 85870518 then
		for i, v in pairs(game.Players:GetChildren()) do
			if v.UserId == player.UserId then
				game["Run Service"].Stepped:connect(function()
					if v.Character ~= nil then
						local rootPart = v.Character:WaitForChild("HumanoidRootPart")
						local distance = (script.Parent.Position - rootPart.Position).Magnitude
						
						if distance < 40 then
							if not sound.IsPlaying then
								if rootPart.Parent:FindFirstChild("ForceField") then
									rootPart.Parent.ForceField:Destroy()
								end
								if rootPart.Parent.Humanoid.Health > 0 then
									rootPart.Parent.Humanoid.Health = 0
									sound:Play()
								end
							end
						end
					end
				end)
			end
