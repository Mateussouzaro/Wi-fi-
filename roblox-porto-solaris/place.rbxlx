l></Properties></Item><Item class="BoolValue" referent="RBXV04000000000000000000000000031C"><Properties><bool name="DefinesCapabilities">false</bool><string name="Name">Fogs</string><int64 name="SourceAssetId">-1</int64><bool name="Value">false</bool></Properties></Item></Item></Item><Item class="LocalScript" referent="RBXV04000000000000000000000000031D"><Properties><bool name="DefinesCapabilities">false</bool><bool name="Disabled">false</bool><Content name="LinkedSource"><null></null></Content><string name="Name">EpicLights</string><token name="RunContext">0</token><string name="ScriptGuid">{29599F09-588D-4D6B-9D0A-AFF765593242}</string><ProtectedString name="Source"><![CDATA[--[[

